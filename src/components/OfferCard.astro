---
// The offer card (John, 2026-11-13): one card that stacks everything the price buys, the price
// itself, the buy buttons, the buy-back guarantee and who made it, so a parent sees exactly what
// they get right where they pay. Counts come from the data; no invented "value" figures.
// The same seven things as WhatsIncluded (still used on /waitlist/), said shorter.
import { Image } from 'astro:assets';
import { missions } from '@lib/data';
import { photoImages } from '@lib/images';
import audioData from '../../data/audio.json';
import site from '../../site.config.mjs';
import { isOpen, price } from '@lib/buy';
import BuyButton from '@components/BuyButton.astro';

const crew = isOpen ? site.checkout.crew : null;
const n = missions.length;
const hours = Math.round(Object.values(audioData.minutes as Record<string, number>).reduce((a, b) => a + b, 0) / 60);
const perReader = crew ? Math.round(Number(crew.price.replace(/[^0-9.]/g, '')) / crew.size) : null;
const authorsPhoto = photoImages.get('authors.jpg') ?? null;

const items = [
  { t: 'The whole novel, to read or to hear', d: `All ${n} chapters on screen or read aloud: about ${hours} hours, narrated with an AI voice.` },
  { t: `${n} missions from Uncle Dan`, d: 'One per chapter: rig the poles, read the water, pick the tide, crack the case.' },
  { t: `${n} field missions, done for real`, d: 'Off the screen: knots on real line, a treasure map, a cleanup, a fishing day. A grown-up signs each one off.' },
  { t: 'The Field Journal', d: '30 printable pages to fill in by hand: logs, sketches, the case file, a fish log and a knot log.' },
  { t: 'Three badges and a guide license', d: 'Earned along the way, with a printable Assistant Fishing Guide license at the end.' },
  { t: crew ? `${crew.size} readers, ${crew.size} links` : 'Their own link', d: 'Each reader keeps their own missions, badges and license. A printable gift card comes for every one.' },
  { t: 'Nothing to install', d: 'Arrives the moment you pay. Opens on any phone, tablet or computer; no app, no account.' },
];
---

<section class="offer" id="offer" aria-labelledby="offer-h">
  <div class="wrap-wide">
    <div class="offer-card">
      <p class="eyebrow">What your crew gets</p>
      <h2 id="offer-h">{crew ? 'The Full Crew Experience' : 'The Summer Fishing Guide Experience'}</h2>
      <p class="offer-sub">One purchase. {crew ? `Up to ${crew.size === 5 ? 'five' : crew.size} readers.` : ''} A whole summer in the Everglades.</p>

      <ul class="offer-list">
        {
          items.map((i) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="offer-tick"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <div>
                <strong>{i.t}</strong>
                <span>{i.d}</span>
              </div>
            </li>
          ))
        }
      </ul>

      {
        crew && (
          <div class="offer-total">
            <p class="offer-total-label">All of it, for up to {crew.size === 5 ? 'five' : crew.size} readers</p>
            <p class="offer-total-price">
              <span class="mono">{crew.price}</span> once
            </p>
            <p class="offer-total-note">
              About ${perReader} a reader. No subscription. Nothing renews. One reader on their own is {price}.
            </p>
          </div>
        )
      }

      <BuyButton plain note={false} />

      <div class="offer-promise">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="offer-seal"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><path d="M8.8 12.2l2.3 2.3 4.2-4.4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <div>
          <p class="offer-promise-h hand">Guaranteed worth it, or the authors buy it back.</p>
          <p class="offer-promise-d">
            If it isn’t right for your family, or the family you gave it to, email <a href="mailto:help@lostmansriver.com">help@lostmansriver.com</a> within 30 days and we refund you in full. No questions asked.
          </p>
        </div>
      </div>

      <div class="offer-authors">
        {authorsPhoto && <Image src={authorsPhoto} alt="John McKillop and his mother Linda, the book’s co-authors" width={112} loading="lazy" class="offer-photo" />}
        <p>
          Written by Linda and John McKillop, mother and son, with Linda’s illustrations. Rated <strong>{site.reviews.rating}</strong> by {site.reviews.count} Amazon readers. A real person answers <a href="mailto:help@lostmansriver.com">help@lostmansriver.com</a>.
        </p>
      </div>
      <p class="small muted offer-fine">Secure checkout by Stripe. The total shows before you pay.</p>
    </div>
  </div>
</section>

<style>
  .offer {
    padding-block: 1.75rem 0.75rem;
  }
  .offer-card {
    max-width: 640px;
    margin-inline: auto;
    padding: 1.4rem 1.15rem 1.2rem;
    background: var(--paper-2);
    border: 2px solid var(--mangrove);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }
  @media (min-width: 640px) {
    .offer-card {
      padding: 1.8rem 1.9rem 1.5rem;
    }
  }
  .offer-card h2 {
    margin: 0.1rem 0 0.25rem;
    font-size: clamp(1.5rem, 4.4vw, 1.95rem);
    line-height: 1.15;
  }
  .offer-sub {
    margin: 0 0 1rem;
    color: var(--ink-soft);
  }
  .offer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .offer-list li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
  }
  .offer-tick {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
    padding: 0.2rem;
    border-radius: 50%;
    background: var(--mangrove);
    color: var(--paper);
  }
  .offer-list strong {
    display: block;
    color: var(--mangrove);
    font-size: 1.03rem;
    line-height: 1.3;
  }
  .offer-list span {
    display: block;
    font-size: 0.93rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .offer-total {
    margin: 1.15rem 0 0.2rem;
    padding-top: 0.95rem;
    border-top: 2px dashed var(--oyster);
  }
  .offer-total p {
    margin: 0;
  }
  .offer-total-label {
    font-weight: 600;
  }
  .offer-total-price {
    font-size: 1.15rem;
    line-height: 1.2;
    color: var(--ink-soft);
  }
  .offer-total-price .mono {
    font-size: 2rem;
    font-weight: 700;
    color: var(--sunrise-ink);
  }
  .offer-total-note {
    font-size: 0.93rem;
    color: var(--ink-soft);
    margin-top: 0.15rem;
  }
  /* the crew button fills the card on one line (318px inside the card at a 390px phone) */
  .offer-card :global(.buy-btn) {
    width: 100%;
    justify-content: space-between;
    padding-inline: 1rem;
  }
  .offer-promise {
    display: grid;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    margin-top: 1rem;
    padding: 0.85rem 0.9rem;
    background: var(--paper);
    border: 1px solid var(--oyster);
    border-radius: 10px;
  }
  .offer-seal {
    width: 2.4rem;
    height: 2.4rem;
    color: var(--mangrove);
  }
  .offer-promise p {
    margin: 0;
  }
  .offer-promise-h {
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--sunrise-ink);
  }
  .offer-promise-d {
    margin-top: 0.25rem;
    font-size: 0.93rem;
    line-height: 1.45;
  }
  .offer-authors {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .offer-authors p {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .offer-photo {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 25%;
    border: 2px solid #c9a24a;
  }
  .offer-fine {
    margin: 0.8rem 0 0;
    text-align: center;
  }
</style>
