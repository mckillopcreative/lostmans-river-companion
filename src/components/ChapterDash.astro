---
// The chapter panel: what a reader sees first on a chapter page, laid out like the app mock the
// author approved (2026-11-04/05): a painted banner with the book's name, a green "Chapter n"
// ribbon, the chapter's title and its one-line tactic, then the cards two across even on a phone
// (chart & route | fish of the chapter, knot | audio guide, tide full width) and the chapter
// arrows. On a phone the cards are compact (painting and name, the knot's drawings in a row);
// from 640px up they carry the full text.
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { Image } from 'astro:assets';
import MiniMap from '@components/MiniMap.astro';
import ChapterAudio from '@components/ChapterAudio.astro';
import TideWindow from '@components/TideWindow.astro';
import { chapterByN, fishById, wildlifeById, knots, routeByChapter, type Chapter } from '@lib/data';
import { artImage } from '@lib/images';
import { chapterUrl, url } from '@lib/url';

interface Props {
  chapter: Chapter;
}
const { chapter } = Astro.props;
const n = chapter.n;
const prev = chapterByN.get(n - 1);
const next = chapterByN.get(n + 1);
const route = routeByChapter.get(n);
const hero = artImage('tiles', 'app-hero');

// the species of the chapter: the fish or critter its text talks about most (chapters.json `star`,
// from scripts/feature-fish.mjs); chapter 7 is the tarpon, chapter 2 the pelican rookery
const star = chapter.star;
const fish = star?.kind === 'fish' ? fishById.get(star.id) : undefined;
const critter = star?.kind === 'wildlife' ? wildlifeById.get(star.id) : undefined;
const speciesArt = fish ? artImage('fish', fish.id) : critter ? artImage('wildlife', critter.id) : null;
const clip = (s: string | undefined, n = 140) => (s && s.length > n ? s.slice(0, s.lastIndexOf(' ', n)) + '…' : s || '');

// the knot of the chapter, else the latest one learned so far (keep practising)
const learned = knots.filter((k) => k.chapter <= n).sort((a, b) => b.chapter - a.chapter);
const knot = learned[0];
const knotIsNew = knot?.chapter === n;
const firstKnot = knots.slice().sort((a, b) => a.chapter - b.chapter)[0];

// the step drawings keep their own shape: most knots are drawn tall, the Albright wide
const knotBox = (id: string) => {
  const svg = readFileSync(resolve(process.cwd(), `public/knots/${id}-1.svg`), 'utf8');
  const [, vw, vh] = svg.match(/viewBox="0 0 (\d+) (\d+)"/) ?? [];
  const w = Number(vw) || 120, h = Number(vh) || 60;
  return h > w ? { w: Math.round((120 * w) / h), h: 120 } : { w: 120, h: Math.round((120 * h) / w) };
};
const box = knot ? knotBox(knot.id) : { w: 120, h: 60 };
---

<section class="dash" aria-label={`Chapter ${n} at a glance`}>
  <div class="dash-top">
    {hero && <Image class="dash-art" src={hero} alt="" width={1200} sizes="(min-width: 900px) 860px, 96vw" loading="eager" fetchpriority="high" />}
    <p class="dash-brand">
      <span class="dash-brand-a">Escape to</span>
      <span class="dash-brand-b">Lostman’s River</span>
    </p>
    <p class="dash-ribbon"><span>Chapter {n}</span></p>
  </div>
  <h1 class="dash-title">{chapter.title}</h1>
  {chapter.tactic && <p class="dash-tactic">{chapter.tactic}</p>}

  <div class="dash-grid">
    {
      chapter.places.length > 0 && (
        <div class="dc dc-chart">
          <h2 class="dc-h">{route ? 'Chart & route' : 'Where we are'}</h2>
          <div class="dc-b dc-b-chart">
            <MiniMap chapter={n} placeIds={chapter.places} />
          </div>
        </div>
      )
    }

    {
      (fish || critter) && (
        <div class="dc dc-fish">
          <h2 class="dc-h">{fish ? 'Fish of the chapter' : 'Wildlife of the chapter'}</h2>
          <a class="dc-b dc-b-fish" href={url(fish ? `/fish/${fish.id}/` : `/critters/${critter!.id}/`)}>
            {speciesArt && <Image class="art" src={speciesArt} alt="" width={520} sizes="(min-width: 640px) 300px, 45vw" loading="eager" />}
            <span class="sp-name">{fish ? fish.common : critter!.name}</span>
            {(fish?.scientific || critter?.scientific) && <span class="sp-sci">{fish ? fish.scientific : critter!.scientific}</span>}
            {fish?.typical_size && <span class="sp-size mono">{fish.typical_size}</span>}
            <span class="sp-line small">{clip(fish ? fish.in_book : critter!.in_book)}</span>
          </a>
        </div>
      )
    }

    <div class="dc dc-knot">
      <h2 class="dc-h">{knot ? (knotIsNew ? 'Knot of the chapter' : 'Keep practising') : 'Knots'}</h2>
      <div class="dc-b">
        {
          knot ? (
            <>
              <a class="kn-name" href={url(`/knots/#${knot.id}`)}>
                {knot.name}
                {!knotIsNew && <span class="small muted kn-from"> · from chapter {knot.chapter}</span>}
              </a>
              <ol class="kn-steps">
                {knot.steps.map((s, i) => (
                  <li>
                    <img src={url(`/knots/${knot.id}-${i + 1}.svg`)} alt={`Step ${i + 1}`} width={box.w} height={box.h} loading="lazy" />
                    <span>{s}</span>
                  </li>
                ))}
              </ol>
              <p class="small kn-use">{knot.use}</p>
              <a class="small kn-more" href={url(`/knots/#${knot.id}`)}>Tie it step by step →</a>
            </>
          ) : (
            <p class="small">
              Matt ties his first knot, the {firstKnot.name.toLowerCase()}, in <a href={chapterUrl(firstKnot.chapter)}>chapter {firstKnot.chapter}</a>. <a href={url('/knots/')}>See all five →</a>
            </p>
          )
        }
      </div>
    </div>

    <div class="dc dc-audio">
      <h2 class="dc-h">Audio guide</h2>
      <div class="dc-b dc-b-audio">
        <ChapterAudio n={n} title={`Chapter ${n}, read aloud`} compact />
      </div>
    </div>

    <div class="dc dc-tide">
      <h2 class="dc-h">Tide &amp; bite window · today</h2>
      <div class="dc-b">
        <TideWindow />
      </div>
    </div>
  </div>

  <nav class="dash-nav" aria-label="Chapters">
    {prev ? <a class="dn-side" href={chapterUrl(prev.n)}>‹ Chapter {prev.n}</a> : <a class="dn-side" href={url('/app/')}>‹ Home</a>}
    <span class="dn-current">Chapter {n}</span>
    {next ? <a class="dn-side dn-next" href={chapterUrl(next.n)}>Chapter {next.n} ›</a> : <a class="dn-side dn-next" href={url('/license/')}>Your license ›</a>}
  </nav>
</section>

<style>
  .dash {
    margin: 0.25rem 0 1.5rem;
  }

  /* ---- the painted top: the book's name over the river, the chapter ribbon hanging off it ---- */
  .dash-top {
    position: relative;
    border-radius: 14px;
    overflow: visible;
    aspect-ratio: 2 / 1;
    margin-bottom: 1.1rem;
    box-shadow: var(--shadow);
  }
  @media (min-width: 640px) {
    .dash-top {
      aspect-ratio: 3 / 1;
    }
  }
  .dash-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    border-radius: 14px;
  }
  .dash-brand {
    position: absolute;
    inset: 0 0 auto 0;
    margin: 0;
    padding: 0.55rem 1rem 1.6rem;
    text-align: center;
    background: linear-gradient(180deg, color-mix(in srgb, var(--paper) 88%, transparent) 40%, transparent);
    border-radius: 14px 14px 0 0;
    line-height: 1.05;
    color: var(--mangrove);
  }
  .dash-brand-a {
    display: block;
    font-family: var(--font-hand);
    font-size: 1.05rem;
    color: var(--sunrise-ink);
  }
  .dash-brand-b {
    display: block;
    font-family: var(--font-display, var(--font-serif));
    font-weight: 700;
    font-size: clamp(1.5rem, 6vw, 2.2rem);
    letter-spacing: 0.01em;
  }
  .dash-ribbon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.95rem;
    margin: 0;
    text-align: center;
  }
  .dash-ribbon span {
    display: inline-block;
    padding: 0.32rem 1.6rem;
    background: var(--mangrove);
    color: var(--paper);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    clip-path: polygon(1.5% 8%, 99% 0, 98.5% 94%, 0.5% 100%);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.18);
  }
  .dash-title {
    margin: 1.4rem 0 0.1rem;
    text-align: center;
    font-size: clamp(1.45rem, 5vw, 2.1rem);
    line-height: 1.15;
    text-wrap: balance;
  }
  .dash-tactic {
    margin: 0.2rem 0 1rem;
    text-align: center;
    font-style: italic;
    font-weight: 600;
    color: var(--mangrove);
    font-size: 1.02rem;
    text-wrap: balance;
  }

  /* ---- the cards: two across on a phone, 3:2 from 640px ---- */
  .dash-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .dc-tide {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .dash-grid {
      gap: 12px;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
    .dc-chart { grid-column: 1; }
    .dc-fish { grid-column: 2; }
    .dc-knot { grid-column: 1; }
    .dc-audio { grid-column: 2; }
  }
  .dc {
    background: var(--paper-2);
    border: 1px solid var(--oyster);
    border-radius: 10px;
    overflow: hidden;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .dc-h {
    margin: 0;
    padding: 0.42rem 0.85rem;
    background: var(--mangrove);
    color: var(--paper);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .dc-b {
    padding: 0.75rem 0.85rem;
    flex: 1;
  }
  .dc-b-chart {
    padding: 0.5rem;
  }
  .dc-b-chart :global(.minimap) {
    margin: 0;
  }
  .dc-b-fish {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    text-decoration: none;
    color: inherit;
  }
  .dc-b-fish img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 0.3rem;
  }
  .sp-name {
    font-weight: 700;
    color: var(--mangrove);
    font-size: 1.15rem;
  }
  .sp-sci {
    font-style: italic;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .sp-size {
    font-size: 0.72rem;
    color: var(--sunrise-ink);
  }
  .sp-line {
    color: var(--ink-soft);
  }
  .kn-name {
    font-weight: 700;
    color: var(--mangrove);
    text-decoration: none;
    font-size: 1.1rem;
  }
  .kn-steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 0.6rem 0 0;
    display: grid;
    gap: 0.45rem;
  }
  .kn-steps li {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6rem;
    align-items: center;
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .kn-steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--mangrove);
    color: var(--paper);
    font-size: 0.7rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    transform: translate(-4px, -22px);
  }
  .kn-steps img {
    display: block;
    max-width: 120px;
    height: auto;
    background: var(--paper);
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--oyster) 60%, transparent);
  }
  .kn-use {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }
  .kn-more {
    display: none;
  }
  .dc-b-audio :global(.listen) {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  /* ---- phone: the cards get compact, like the mock ---- */
  @media (max-width: 639px) {
    .dc-h {
      font-size: 0.8rem;
      padding: 0.32rem 0.6rem;
    }
    .dc-b {
      padding: 0.55rem 0.6rem;
    }
    .dc-b-chart {
      padding: 0.35rem;
    }
    .sp-name {
      font-size: 1rem;
    }
    .sp-sci {
      font-size: 0.8rem;
    }
    .sp-size,
    .sp-line {
      display: none;
    }
    .kn-name {
      font-size: 0.95rem;
    }
    .kn-from {
      display: block;
    }
    /* the knot's drawings two by two, no step text (that's on the knots page) */
    .kn-steps {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 0.4rem;
      margin-top: 0.5rem;
    }
    .kn-steps li {
      display: block;
    }
    .kn-steps li span {
      display: none;
    }
    .kn-steps li::before {
      transform: translate(-4px, -6px);
      width: 16px;
      height: 16px;
      font-size: 0.6rem;
    }
    .kn-steps img {
      max-width: 100%;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: contain;
    }
    /* the chart: route and dots only; the place names crowd a half-width map */
    .dc-b-chart :global(.mm-label),
    .dc-b-chart :global(.leaflet-tooltip),
    .dc-b-chart :global(.leaflet-control-attribution) {
      display: none;
    }
    .dc-b-chart :global(figcaption) {
      display: grid;
      gap: 0.1rem;
      font-size: 0.8rem;
      line-height: 1.3;
    }
    .dc-b-chart :global(.mm-cap) {
      font-size: 0.95rem;
    }
    .kn-use {
      display: none;
    }
    .kn-more {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--mangrove);
    }
    .dc-b-audio :global(.listen-meta) {
      display: none;
    }
    .dc-b-audio :global(.listen-head) {
      gap: 0.5rem;
      margin-bottom: 0.4rem;
    }
    .dc-b-audio :global(.listen-icon) {
      width: 22px;
      height: 22px;
      margin-top: 0.15rem;
    }
    .dc-b-audio :global(.listen-eyebrow) {
      font-size: 1rem;
    }
    .dc-b-audio :global(.listen-title) {
      font-size: 0.95rem;
    }
    .dc-b-audio :global(audio) {
      width: 100%;
      height: 36px;
    }
  }

  /* ---- chapter arrows ---- */
  .dash-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    margin-top: 12px;
    padding: 0.5rem 0.75rem;
    background: var(--paper-2);
    border: 1px solid var(--oyster);
    border-radius: 999px;
  }
  .dn-side {
    text-decoration: none;
    font-weight: 600;
    color: var(--mangrove);
    font-size: 0.95rem;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  @media (max-width: 420px) {
    .dn-side {
      font-size: 0.85rem;
    }
    .dn-current {
      padding-inline: 0.8rem;
    }
  }
  .dn-next {
    justify-self: end;
  }
  .dn-current {
    padding: 0.3rem 1.1rem;
    border-radius: 999px;
    background: var(--mangrove);
    color: var(--paper);
    font-weight: 700;
    white-space: nowrap;
  }
</style>
