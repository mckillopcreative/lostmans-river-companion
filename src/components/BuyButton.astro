---
// The two ways to buy (2026-11-11, John: "lead with the crew"): the Full Crew Experience, up to
// five readers each with their own link and progress, is the big orange button; "Just me", one
// reader, is the quieter one underneath. Both are Stripe Payment Links from site.config. The
// paperback is pointed at Amazon underneath (no shipping sold here). Before opening day it goes
// to the waitlist instead (src/lib/buy.ts).
import site from '../../site.config.mjs';
import { isOpen, buyHref, buyTrack, opens, price } from '@lib/buy';

interface Props {
  compact?: boolean;
  /** the refund / paperback line under the buttons */
  note?: boolean;
  /** buttons only: no "Fill your boat" lead, promise line or crew note (the offer card says them) */
  plain?: boolean;
}
const { compact = false, note = true, plain = false } = Astro.props;
const crew = isOpen ? site.checkout.crew : null;
---

<div class:list={['buy', { compact }]}>
  {
    crew ? (
      <>
        {!plain && <p class="crew-lead hand">Fill your boat with up to 5 readers…</p>}
        <a class="btn btn-primary buy-btn" href={crew.url} rel="noopener" data-direct="1" data-track="crew_click" data-track-page={Astro.url.pathname}>
          The Full Crew Experience <span class="buy-price mono">{crew.price}</span>
        </a>
        {!plain && <p class="crew-promise hand">Guaranteed worth it, or the authors buy it back.</p>}
        {!plain && (
          <p class="small crew-note">
            <strong class="crew-em">Up to five readers</strong> working the summer together or separately, each with their own missions, badges and license: brothers, sisters, cousins, friends.
          </p>
        )}
        {plain && <span class="plain-gap" />}
        <a class="btn solo-btn" href={buyHref} rel="noopener" data-track={buyTrack} data-track-page={Astro.url.pathname}>
          Single Reader <span class="mono">{price}</span>
        </a>
      </>
    ) : (
      <a class="btn btn-primary buy-btn" href={buyHref} data-track={buyTrack} data-track-page={Astro.url.pathname}>
        Opens {opens}: join the list
      </a>
    )
  }
  {
    note && (
      <p class="small muted buy-note">
        {isOpen ? 'One-time purchase, 30-day refund.' : 'One-time purchase. We’ll email you once, the morning it opens.'} Want the paperback?{' '}
        <a href={site.buyUrl} rel="noopener" data-track="amazon_click" data-track-page={Astro.url.pathname}>
          It’s on Amazon
        </a>
        {site.reviews && (
          <>
            , rated <strong>{site.reviews.rating}</strong> by {site.reviews.count} readers
          </>
        )}
        .
      </p>
    )
  }
</div>

<style>
  .buy {
    margin: 0.9rem 0 0.4rem;
  }
  .buy-btn {
    font-size: 1.05rem;
    padding-inline: 1.3rem;
    gap: 0.6rem;
    text-align: left;
  }
  .buy-price {
    font-size: 0.8em;
    opacity: 0.9;
  }
  .crew-lead {
    margin: 0 0 0.35rem;
    font-size: 1.3rem;
    color: var(--sunrise-ink);
  }
  .crew-promise {
    margin: 0.35rem 0 0;
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--sunrise-ink);
  }
  .crew-note {
    margin: 0.3rem 0 0.6rem;
    max-width: 34rem;
  }
  .plain-gap {
    display: block;
    height: 0.55rem;
  }
  .solo-btn {
    min-height: 40px;
    padding: 0.4em 1em;
    font-size: 0.95rem;
    background: var(--paper);
  }
  .buy-note {
    margin: 0.55rem 0 0;
  }
  .compact {
    margin-top: 0.6rem;
  }
  .compact .buy-btn {
    font-size: 0.95rem;
  }
  .compact .solo-btn {
    font-size: 0.9rem;
  }
</style>
