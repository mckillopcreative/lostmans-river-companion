---
// The one Buy button: Stripe Payment Link from site.config, with the paperback pointed at
// Amazon underneath (no shipping sold here; decided 2026-10-20).
import site from '../../site.config.mjs';

interface Props {
  compact?: boolean;
  /** what the button says before the price */
  label?: string;
}
const { compact = false, label = 'Get the Full Experience' } = Astro.props;
const c = site.checkout;
---

{
  c?.url && (
    <div class:list={['buy', { compact }]}>
      <a class="btn btn-primary buy-btn" href={c.url} rel="noopener">
        {label} <span class="buy-price mono">{c.price}</span>
      </a>
      <p class="small muted buy-note">
        One-time purchase, 30-day refund. Want the paperback? <a href={site.buyUrl} rel="noopener">It’s on Amazon</a>.
      </p>
    </div>
  )
}

<style>
  .buy {
    margin: 0.9rem 0 0.4rem;
  }
  .buy-btn {
    font-size: 1.05rem;
    padding-inline: 1.3rem;
    gap: 0.6rem;
  }
  .buy-price {
    font-size: 0.8em;
    opacity: 0.9;
  }
  .buy-note {
    margin: 0.45rem 0 0;
  }
  .compact {
    margin-top: 0.6rem;
  }
  .compact .buy-btn {
    font-size: 0.95rem;
  }
</style>
