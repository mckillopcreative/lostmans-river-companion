---
// The one Buy button: Stripe Payment Link from site.config, with the paperback pointed at
// Amazon underneath (no shipping sold here; decided 2026-10-20). Before opening day it goes to
// the waitlist instead (src/lib/buy.ts).
import site from '../../site.config.mjs';
import { isOpen, buyHref, buyTrack, opens, price } from '@lib/buy';

interface Props {
  compact?: boolean;
  /** what the button says before the price */
  label?: string;
  /** the refund / paperback line under the button */
  note?: boolean;
}
const { compact = false, label = 'Get the Full Experience', note = true } = Astro.props;
---

<div class:list={['buy', { compact }]}>
  <a class="btn btn-primary buy-btn" href={buyHref} rel={isOpen ? 'noopener' : undefined} data-track={buyTrack} data-track-page={Astro.url.pathname}>
    {isOpen ? label : `Opens ${opens}: join the list`} <span class="buy-price mono">{price}</span>
  </a>
  {
    note && (
      <p class="small muted buy-note">
        {isOpen ? 'One-time purchase, 30-day refund.' : `One-time purchase. We’ll email you once, on ${opens}.`} Want the paperback?{' '}
        <a href={site.buyUrl} rel="noopener" data-track="amazon_click" data-track-page={Astro.url.pathname}>
          It’s on Amazon
        </a>
        {site.reviews && (
          <>
            , rated <strong>{site.reviews.rating}</strong> by {site.reviews.count} readers
          </>
        )}
        .
      </p>
    )
  }
</div>

<style>
  .buy {
    margin: 0.9rem 0 0.4rem;
  }
  .buy-btn {
    font-size: 1.05rem;
    padding-inline: 1.3rem;
    gap: 0.6rem;
  }
  .buy-price {
    font-size: 0.8em;
    opacity: 0.9;
  }
  .buy-note {
    margin: 0.45rem 0 0;
  }
  .compact {
    margin-top: 0.6rem;
  }
  .compact .buy-btn {
    font-size: 0.95rem;
  }
</style>
