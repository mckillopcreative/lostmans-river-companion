---
// One way in since 2026-11-15 (John): one orange button at the one-reader price, which opens the
// confirm sheet (BuyConfirm.astro); the Full Boat bonus (the crew product, up to five readers) is
// a toggle there and a line under the button here. Both are Stripe Payment Links from site.config. The
// paperback is pointed at Amazon underneath (no shipping sold here). Before opening day it goes
// to the waitlist instead (src/lib/buy.ts).
import site from '../../site.config.mjs';
import { isOpen, buyHref, buyTrack, opens, price } from '@lib/buy';

interface Props {
  compact?: boolean;
  /** the refund / paperback line under the buttons */
  note?: boolean;
  /** buttons only: no "Fill your boat" lead, promise line or crew note (the offer card says them) */
  plain?: boolean;
  /** the id of the offer card: show one "Hook the Experience" pill that scrolls to it, in place of the buttons (the landing hero) */
  jump?: string;
  /** a small label pinned to the crew button, e.g. "Holiday Special" (the offer card passes site.checkout.crew.tag) */
  tag?: string;
  /** where this set of buttons sits, added to the click label ("card" → "/:card") */
  place?: string;
}
const { compact = false, note = true, plain = false, jump = '', tag = '', place = '' } = Astro.props;
const where = Astro.url.pathname + (place ? `:${place}` : '');
const crew = isOpen ? site.checkout.crew : null;
// what the Full Boat bonus adds to the one-reader price, e.g. "+$15"
const cents = (v: string) => Math.round(Number(v.replace(/[^0-9.]/g, '')) * 100);
const boatDiff = crew ? (cents(crew.price) - cents(price)) / 100 : 0;
const boatPlus = '+$' + (Number.isInteger(boatDiff) ? boatDiff : boatDiff.toFixed(2));
void tag;
---

<div class:list={['buy', { compact }]}>
  {
    crew && jump ? (
      <>
        <p class="crew-lead hand">Fill your boat with up to 5 readers…</p>
        <a class="btn btn-primary hook-pill" href={`#${jump}`} data-track="hook_click" data-track-page={Astro.url.pathname}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v9a4 4 0 0 0 8 0" /><path d="M20 12a2 2 0 1 0-4 0" /><circle cx="12" cy="3" r="1" /></svg>
          Hook the Experience
          <span class="buy-price mono">{price}</span>
        </a>
        {/* the gift line (John, 2026-11-15): the welcome email can be forwarded, and /gift/ prints a card or saves it as a PDF */}
        <p class="gift-line">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13" /><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" /></svg>
          <span><strong>A holiday gift that’s ready today.</strong> Email it, or print the included gift card.</span>
        </p>
      </>
    ) : crew ? (
      <>
        {!plain && <p class="crew-lead hand">Fill your boat with up to 5 readers…</p>}
        <a class="btn btn-primary buy-btn" href={buyHref} rel="noopener" data-track={buyTrack} data-track-page={where}>
          <span class="buy-label">Hook the Experience</span>
          <span class="buy-price mono">{price}</span>
        </a>
        <p class="small boat-note">
          <strong class="crew-em">Full Boat bonus:</strong> add up to four more readers for {boatPlus} at checkout, each with their own missions, badges and license.
        </p>
        {!plain && <p class="crew-promise hand">Guaranteed worth it, or the authors buy it back.</p>}
      </>
    ) : (
      <a class="btn btn-primary buy-btn" href={buyHref} data-track={buyTrack} data-track-page={where}>
        Opens {opens}: join the list
      </a>
    )
  }
  {
    note && (
      <p class="small muted buy-note">
        {isOpen ? 'One-time purchase, 30-day refund.' : 'One-time purchase. We’ll email you once, the morning it opens.'} Want the paperback?{' '}
        <a href={site.buyUrl} rel="noopener" data-track="amazon_click" data-track-page={where}>
          It’s on Amazon
        </a>
        {site.reviews && (
          <>
            , rated <strong>{site.reviews.rating}</strong> by {site.reviews.count} readers
          </>
        )}
        .
      </p>
    )
  }
</div>

<style>
  .buy {
    margin: 0.9rem 0 0.4rem;
  }
  .buy-btn {
    font-size: 1.05rem;
    padding-inline: 1.3rem;
    gap: 0.6rem;
    text-align: left;
  }
  /* the crew button's second thought: beside the name on a wide screen, under it on a phone */
  .buy-sub {
    font-weight: 500;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .buy-sub {
      display: block;
      font-size: 0.86em;
      line-height: 1.25;
    }
    .buy-dash {
      display: none;
    }
  }
  .buy-price {
    font-size: 0.8em;
    opacity: 0.9;
  }
  .crew-lead {
    margin: 0 0 0.35rem;
    font-size: 1.3rem;
    color: var(--sunrise-ink);
  }
  .crew-promise {
    margin: 0.35rem 0 0;
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--sunrise-ink);
  }
  .boat-note {
    margin: 0.45rem 0 0;
    max-width: 34rem;
  }
  .crew-note {
    margin: 0.3rem 0 0.6rem;
    max-width: 34rem;
  }
  .hook-pill {
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-size: 1.1rem;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.16);
  }
  .gift-line {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    max-width: 30rem;
    font-size: 0.98rem;
    line-height: 1.4;
    color: var(--mangrove);
    text-wrap: balance;
  }
  /* the bold sentence gets its own line, so the second never strands a word (390 px: 330 px of text) */
  .gift-line strong {
    display: block;
  }
  .gift-line svg {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.08rem;
    color: var(--sunrise-ink);
  }
  .tagged {
    position: relative;
    margin-top: 0.55rem;
  }
  .buy-tag {
    position: absolute;
    top: -0.72rem;
    left: 0.85rem;
    padding: 0.12rem 0.6rem 0.14rem;
    border-radius: 999px;
    background: var(--mangrove);
    color: var(--paper);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18);
  }
  .plain-gap {
    display: block;
    height: 0.55rem;
  }
  .solo-btn {
    min-height: 40px;
    padding: 0.4em 1em;
    font-size: 0.95rem;
    background: var(--paper);
  }
  .buy-note {
    margin: 0.55rem 0 0;
  }
  .compact {
    margin-top: 0.6rem;
  }
  .compact .buy-btn {
    font-size: 0.95rem;
  }
  .compact .solo-btn {
    font-size: 0.9rem;
  }
</style>
