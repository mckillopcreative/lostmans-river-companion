---
// Chapter 1: the free reading sample: the welcome line, the chapter heading, the opening
// paragraphs, and the rest behind a "Keep reading" fold (a <details>, so it works without JS),
// from data/sample-ch01.json (scripts/extract-sample.mjs).
// Chapters 2–23: the full-book reader. The text is never in the page; on a device holding a
// purchase key it is fetched from the Worker (from 2026-11-26, after KDP Select) and set here.
import sample from '../../data/sample-ch01.json';
import site from '../../site.config.mjs';
import { chapterByN } from '@lib/data';
import { url } from '@lib/url';
import BuyButton from './BuyButton.astro';

interface Props {
  n: number;
  /** paragraphs shown before the fold */
  open?: number;
}
const { n, open = 3 } = Astro.props;
const s = sample.n === n ? sample : null;
const head = s?.paragraphs.slice(0, open) ?? [];
const rest = s?.paragraphs.slice(open) ?? [];
const full = !s && n >= 2 && n <= 23 && !!site.gate?.live;
const title = chapterByN.get(n)?.title ?? '';
const next = chapterByN.get(n + 1);
---

{
  full && (
    <section class="read read-full" id={`read-ch-${String(n).padStart(2, '0')}`} aria-labelledby="read-h" data-ch={n} hidden>
      <h2 id="read-h" class="read-title">
        Chapter {n} <span class="read-dash">–</span> <em>{title}</em>
      </h2>
      <p class="read-status small muted" aria-live="polite">Opening the chapter…</p>
      <div class="read-body" />
      <div class="read-after" hidden>
        <p class="read-end hand">End of Chapter {n}.</p>
        <p class="cluster read-after-links">
          <a class="btn btn-primary" href={url(`/missions/m${String(n).padStart(2, '0')}/`)}>
            Mission {n} →
          </a>
          {next && <a class="btn" href={url(`/ch/${n + 1}/`)}>Chapter {n + 1}: {next.title}</a>}
        </p>
      </div>
    </section>
  )
}

{
  s && (
    <section class="read" id={`read-ch-${String(n).padStart(2, '0')}`} aria-labelledby="read-h">
      <p class="read-welcome hand">{s.welcome}</p>
      <h2 id="read-h" class="read-title">
        Chapter {s.n} <span class="read-dash">–</span> <em>{s.title}</em>
      </h2>
      <div class="read-body">
        {head.map((p) => <p>{p}</p>)}
        {rest.length > 0 && (
          <details class="read-more">
            <summary>
              <span class="read-more-open">Keep reading ↓</span>
              <span class="read-more-close">Fold it back up ↑</span>
            </summary>
            {rest.map((p) => <p>{p}</p>)}
            <p class="read-end hand">End of Chapter {s.n}.</p>
            <div class="read-next">
              <p class="read-next-h">Want to know what happens next?</p>
              <p class="read-next-opts">
                <a class="btn" href={site.buyUrl} rel="noopener" data-track="amazon_click" data-track-page="read-end">Read the whole book: paperback or Kindle on Amazon →</a>
              </p>
              <p class="small muted">Or read and hear the whole book here, with the missions, the field missions and the license:</p>
              <BuyButton compact note={false} />
              <p class="small muted">One-time purchase, 30-day refund.</p>
            </div>
          </details>
        )}
      </div>
    </section>
  )
}

<script>
  import { textUrl } from '../scripts/access';
  import { track } from '../scripts/track';

  // the full-book reader (chapters 2–23): only on a device with a purchase key
  document.querySelectorAll<HTMLElement>('.read-full').forEach(async (sec) => {
    const ch = Number(sec.dataset.ch);
    const src = textUrl(ch);
    if (!src) return; // no key: the audio panel above already says what the Experience includes
    sec.hidden = false;
    const status = sec.querySelector<HTMLElement>('.read-status')!;
    const body = sec.querySelector<HTMLElement>('.read-body')!;
    try {
      const r = await fetch(src);
      if (r.status === 425) {
        status.textContent = 'The text of every chapter arrives here on November 26. Until then, listen to it above, or read along in the paperback.';
        return;
      }
      if (!r.ok) throw new Error(String(r.status));
      const j = (await r.json()) as { paragraphs: string[] };
      for (const t of j.paragraphs) {
        const p = document.createElement('p');
        p.textContent = t;
        body.appendChild(p);
      }
      status.remove();
      const after = sec.querySelector<HTMLElement>('.read-after')!;
      after.hidden = false;
      const end = after.querySelector('.read-end')!;
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => {
          if (es.some((e) => e.isIntersecting)) {
            track('read_end', { ch });
            io.disconnect();
          }
        });
        io.observe(end);
      }
    } catch {
      status.textContent = 'Couldn’t open the chapter just now. Check the connection and reload the page.';
    }
  });

  document.querySelectorAll<HTMLElement>('.read:not(.read-full)').forEach((sec) => {
    const ch = Number(sec.id.replace(/\D/g, '')) || 0;
    const more = sec.querySelector<HTMLDetailsElement>('.read-more');
    more?.addEventListener('toggle', () => {
      if (more.open) track('read_more', { ch });
    });
    const end = sec.querySelector('.read-end');
    if (end && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) {
          track('read_end', { ch });
          io.disconnect();
        }
      });
      io.observe(end);
    }
  });
</script>

<style>
  .read {
    margin: 1.75rem 0 2rem;
    padding: 1.5rem 1.25rem 1.25rem;
    background: var(--paper-2);
    border: 1px solid color-mix(in srgb, var(--oyster) 55%, transparent);
    border-radius: var(--radius);
  }
  @media (min-width: 640px) {
    .read {
      padding: 2rem 2.25rem 1.5rem;
    }
  }
  .read-welcome {
    margin: 0 0 1rem;
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--sunrise-ink);
    text-align: center;
    text-wrap: balance;
  }
  .read-title {
    margin: 0 0 1.25rem;
    text-align: center;
    font-weight: 400;
    font-size: 1.35rem;
  }
  .read-title em {
    font-style: italic;
  }
  .read-dash {
    color: var(--ink-soft);
  }
  /* set like the paperback: indented paragraphs, no gaps, a comfortable measure */
  .read-body {
    max-width: 62ch;
    margin-inline: auto;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink);
  }
  .read-body p {
    margin: 0;
    text-indent: 1.5em;
    hyphens: auto;
  }
  .read-body > p:first-child {
    text-indent: 0;
  }
  .read-body > p:first-child::first-letter {
    float: left;
    font-size: 3.3em;
    line-height: 0.85;
    padding: 0.06em 0.08em 0 0;
    color: var(--mangrove);
    font-weight: 700;
  }
  .read-more summary {
    list-style: none;
    cursor: pointer;
    margin: 1rem 0 0.5rem;
    text-align: center;
    font-weight: 600;
    color: var(--mangrove);
  }
  .read-more summary::-webkit-details-marker {
    display: none;
  }
  .read-more summary > span {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border: 1.5px solid var(--mangrove);
    border-radius: 999px;
  }
  .read-more:not([open]) summary > .read-more-close,
  .read-more[open] summary > .read-more-open {
    display: none;
  }
  .read-more[open] summary {
    order: 2;
  }
  .read-more[open] {
    display: flex;
    flex-direction: column;
  }
  .read-more[open] > p {
    order: 1;
  }
  .read-next {
    margin-top: 1rem;
    padding: 1rem;
    border-top: 1px dashed var(--oyster);
    text-align: center;
  }
  .read-next p {
    text-indent: 0 !important;
  }
  .read-next-h {
    font-weight: 700;
    color: var(--mangrove);
    font-size: 1.15rem;
    margin: 0 0 0.6rem !important;
  }
  .read-next-opts .btn {
    white-space: normal;
  }
  .read-next :global(.buy) {
    display: grid;
    justify-items: center;
  }
  .read-full[hidden],
  .read-after[hidden] {
    display: none;
  }
  .read-status {
    text-align: center;
    margin: 0;
  }
  .read-after-links {
    justify-content: center;
  }
  .read-after-links .btn {
    white-space: normal;
  }
  .read-end {
    text-indent: 0 !important;
    text-align: center;
    margin-top: 1.25rem !important;
    font-size: 1.2rem;
    color: var(--sunrise-ink);
  }
</style>
