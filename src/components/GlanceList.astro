---
// The three big things, with their numbers, in three short lines right under the landing
// headline (John, 2026-11-16: "the user should know the main things they're getting right away
// with numbers"). Each line jumps to the full "What your reader gets" section (WhatYouGet.astro).
// 2026-11-23 (John): a line at the top of the box says the full Experience is on Amazon too (the
// Crew Pass paperback), with a link. The box is a div now, because a link cannot sit inside a link.
// 2026-11-27 (John): the list was missing parts, the animal trainer among them. The missions get
// their own line, and Wild Florida is named as what it is on this site: an add-on at its own price
// (the Amazon paperback's Crew Pass includes it; a $24.99 purchase here does not).
// Later the same day (John: "Make it included in the digital product"): it is line 5, included.
import site from '../../site.config.mjs';
import { chapters } from '@lib/data';
import audioData from '../../data/audio.json';
import manual from '../../data/manual.json';
import { wild, wildIncluded } from '@lib/buy';
import { wildCount } from '@lib/wild';

const bookHours = Math.round(Object.values(audioData.minutes as Record<string, number>).reduce((a, b) => a + b, 0) / 60);
const manualMin = Object.values(((audioData as unknown as { manual?: Record<string, number> }).manual ?? {}) as Record<string, number>).reduce((a, b) => a + b, 0);
const manualLen = manualMin >= 55 ? 'about an hour' : `${manualMin} minutes`;
---

<div class="glance">
  {
    site.amazonCrewPass && (
      <p class="g-amz">
        <a href={site.buyUrl} rel="noopener" data-track="amazon_click" data-track-page="/:glance">The full experience now available on Amazon →</a>
      </p>
    )
  }
  <a class="g-in" href="#what-you-get" data-track="landing_click" data-track-to="glance" aria-label="What your reader gets: see the details">
  <ol>
    <li>
      <span class="g-n" aria-hidden="true">1</span>
      <span><strong>The book</strong>: {chapters.length} chapters to read, or hear read aloud ({bookHours} hours)</span>
    </li>
    <li>
      <span class="g-n" aria-hidden="true">2</span>
      <span><strong>Guide School</strong>: {manual.lessons.length} audio lessons ({manualLen}) and 4 courses to play</span>
    </li>
    <li>
      <span class="g-n" aria-hidden="true">3</span>
      <span><strong>Matt’s Fishing Journal</strong>: a 20-page field guide</span>
    </li>
    <li>
      <span class="g-n" aria-hidden="true">4</span>
      <span><strong>{chapters.length} missions</strong>, badges and a guide license to earn</span>
    </li>
    {
      wildIncluded && (
        <li>
          <span class="g-n" aria-hidden="true">5</span>
          <span><strong>Wild Florida Animal ID Trainer</strong>: {wildCount} animals to name</span>
        </li>
      )
    }
    {
      wild && (
        <li>
          <span class="g-n g-plus" aria-hidden="true">+</span>
          <span><strong>Wild Florida Animal ID Trainer</strong>: {wildCount} animals to name (add-on, {wild.price})</span>
        </li>
      )
    }
  </ol>
  <span class="g-more">See it all ↓</span>
  </a>
</div>

<style>
  .glance {
    display: block;
    margin: 0.9rem 0;
    padding: 0.75rem 0.9rem 0.7rem;
    background: var(--paper-2);
    border: 1.5px solid var(--oyster);
    border-radius: 14px;
  }
  .glance:hover {
    border-color: var(--mangrove);
  }
  .g-in {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .g-amz {
    margin: 0 0 0.6rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px dashed var(--oyster);
    font-size: 1rem;
    line-height: 1.35;
    font-weight: 700;
    text-wrap: balance;
  }
  .g-amz a {
    display: inline-block;
    padding: 0.2rem 0;
    color: var(--mangrove);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .glance ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .glance li {
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    font-size: 1rem;
    line-height: 1.35;
  }
  .g-n {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--sunrise);
    color: var(--on-sunrise);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
  }
  .g-plus {
    background: var(--mangrove);
    color: var(--paper);
  }
  .glance strong {
    color: var(--mangrove);
  }
  .g-more {
    display: block;
    margin-top: 0.5rem;
    padding-left: 2.3rem;
    font-size: 0.9rem;
    color: var(--sunrise-ink);
  }
</style>
