---
// Guide School on the landing page (John, 2026-11-15): the three named courses, right above the
// offer card, so "missions and challenges" has something a parent can picture. Each card opens
// the course itself (all three have a free first taste).
import { Image } from 'astro:assets';
import { fish } from '@lib/data';
import { artImage } from '@lib/images';
import { url } from '@lib/url';
import rigs from '../../data/rigs.json';
import boat from '../../data/boat-school.json';

const plates = fish.filter((f) => artImage('fish', f.id)).length;
const journalArt = artImage('journal', 'cover');
const courses = [
  { id: 'rig-it-right', href: '/guide-school/rig-it-right/', title: 'Rig It Right', line: 'Read the wind, tide and water, then pick the rig.', count: `${rigs.scenarios.length} scenarios` },
  { id: 'learn-the-boat', href: '/guide-school/learn-the-boat/', title: 'Learn the Boat', line: 'Markers, reading the water, the trailer, the rinse-down.', count: `${boat.lessons.length} lessons` },
  { id: 'fish-id', href: '/games/fish-id/', title: 'Fish of the Everglades', line: 'Name the fish from its painted plate.', count: `${plates} species` },
];
---

<section class="gss" aria-labelledby="gss-h">
  <div class="wrap-wide">
    <p class="eyebrow">Inside the Experience</p>
    <h2 id="gss-h">Guide School</h2>
    <p class="gss-sub">Three courses in the real skills of an Everglades fishing guide. Start each one free.</p>
    <ul class="gss-row">
      {
        courses.map((c) => {
          const art = artImage('tiles', c.id);
          return (
            <li>
              <a href={url(c.href)} data-track="landing_click" data-track-to={`school-${c.id}`}>
                <span class="gss-art art">{art && <Image src={art} alt="" width={520} sizes="(min-width: 760px) 300px, 30vw" loading="lazy" />}</span>
                <span class="gss-title">{c.title}</span>
                <span class="gss-line small">{c.line}</span>
                <span class="gss-count mono">{c.count}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <a class="gss-journal" href={url('/fishing-journal/')} data-track="landing_click" data-track-to="fishing-journal">
      <span class="gss-j-art art">{journalArt && <Image src={journalArt} alt="" width={420} sizes="110px" loading="lazy" />}</span>
      <span class="gss-j-text">
        <span class="gss-count mono">The field guide · 10 chapters · print it</span>
        <span class="gss-j-title">Matt’s Fishing Journal</span>
        <span class="gss-line small">An essential guide to catching the big one: the fish, the keepers, the spots, the rigs, the knots, the pack list.</span>
      </span>
    </a>
  </div>
</section>

<style>
  .gss {
    padding-block: 1.75rem 0.25rem;
  }
  .gss h2 {
    margin: 0.1rem 0 0.25rem;
  }
  .gss-sub {
    margin: 0 0 0.9rem;
    color: var(--ink-soft);
  }
  .gss-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .gss-row a {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 0.45rem 0.45rem 0.6rem;
    background: var(--paper-2);
    border: 1.5px solid var(--oyster);
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
  }
  .gss-row a:hover {
    border-color: var(--mangrove);
  }
  .gss-art {
    display: block;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: color-mix(in srgb, var(--mangrove) 14%, var(--paper));
  }
  .gss-art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gss-title {
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.2;
    color: var(--mangrove);
  }
  .gss-line {
    line-height: 1.3;
    color: var(--ink-soft);
  }
  .gss-journal {
    margin-top: 0.6rem;
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 0.45rem;
    background: var(--paper-2);
    border: 1.5px solid var(--oyster);
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
  }
  .gss-journal:hover {
    border-color: var(--mangrove);
  }
  .gss-j-art {
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    overflow: hidden;
    background: color-mix(in srgb, var(--mangrove) 14%, var(--paper));
  }
  .gss-j-art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gss-j-text {
    display: grid;
    gap: 0.2rem;
  }
  .gss-j-title {
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.2;
    color: var(--mangrove);
  }
  .gss-count {
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sunrise-ink);
  }
  /* a phone shows the three as a column of rows: picture left, words right */
  @media (max-width: 560px) {
    .gss-row {
      grid-template-columns: 1fr;
    }
    .gss-row a {
      grid-template-columns: 84px minmax(0, 1fr);
      column-gap: 0.75rem;
      align-items: center;
      padding: 0.45rem;
    }
    .gss-art {
      grid-row: span 3;
    }
    .gss-title {
      font-size: 1.08rem;
    }
  }
</style>
