---
// A section emblem from assets/art/emblems (emblem-<name>.webp). Renders nothing if absent.
import { Image } from 'astro:assets';
import { artImage } from '@lib/images';
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 96, class: cls } = Astro.props;
const img = artImage('emblems', `emblem-${name}`);
---

{img && <Image class:list={['emblem', 'art', cls]} src={img} alt="" width={size * 2} height={size * 2} style={`width:${size}px;height:${size}px`} loading="eager" />}

<style>
  .emblem {
    object-fit: contain;
    flex: none;
    filter: drop-shadow(0 3px 4px rgb(0 0 0 / 0.12));
  }
</style>
