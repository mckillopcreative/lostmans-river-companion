---
// The confirm step between a Buy tap and Stripe: one sheet that says what they get, how it
// arrives and the promise, then "Continue to secure checkout". Every Buy link keeps its real
// Stripe href (a new tab or no JS still reaches checkout); this script intercepts the tap,
// fires the usual buy_click beacon (track.ts, capture phase, runs first), and opens the sheet.
// Measured both ways: confirm_go (Continue) and confirm_close (dismissed). Added 2026-11-07
// after Bedside Stories found the bare Payment Link hand-off was where buyers leaked.
// 2026-11-15 (John): the sheet also carries the Full Boat bonus, a switch that swaps the one-reader
// link for the Full Crew link (up to five readers) and shows the new total, so the higher price is
// only ever seen as a chosen add-on. With the switch on, Continue counts as crew_click
// ("<page>:sheet"); the switch itself is boat_toggle.
// 2026-11-16 (John): a second switch adds Wild Florida (+$9.99, one price for every seat in the
// boat), with a "What's this?" link that drops down what the add-on is. The two switches pick one
// of four Stripe links (site.config → checkout: url, crew.url, wild.url, wild.crewUrl). Events:
// wild_toggle, wild_what, and wild_go beside the usual Continue event. A Buy link with
// data-wild="1" (the Wild Florida page's lock) opens the sheet with the add-on already on.
import { Image } from 'astro:assets';
import { artImage } from '@lib/images';
import { url } from '@lib/url';
import site from '../../site.config.mjs';
import { bogo, wild } from '@lib/buy';
import { wildCount, wildTotal, wildStarters } from '@lib/wild';
import wildData from '../../data/wild.json';
// a few plates for the drop-down: the animals children ask about first
const wildPlates = wild
  ? ['bull-shark', 'alligator', 'cottonmouth', 'osprey', 'tiger-shark', 'manatee', 'crocodile', 'great-blue-heron']
      .map((id) => ({ src: artImage('wild', id), name: wildData.animals.find((a) => a.id === id)?.name ?? '' }))
      .filter((p) => p.src)
      .slice(0, 4)
  : [];
const wildKinds = wildData.types.map((t) => t.name.toLowerCase()).join(', ');
const thumb = artImage('tiles', 'app-hero');
const price = site.checkout.price;
const crew = site.checkout.open ? site.checkout.crew : null;
const cents = (v: string) => Math.round(Number(v.replace(/[^0-9.]/g, '')) * 100);
const boatDiff = crew ? (cents(crew.price) - cents(price)) / 100 : 0;
const boatPlus = '+$' + (Number.isInteger(boatDiff) ? boatDiff : boatDiff.toFixed(2));
---

<div class="bc-bg" id="buy-confirm" data-price={price} data-prices={[price, site.checkout.crew?.price].filter(Boolean).join('|')} data-sheet={site.checkout.confirmSheet === false ? 'off' : 'on'} data-crew-url={crew?.url || ''} data-crew-price={crew?.price || ''} hidden>
  <div class="bc" role="dialog" aria-modal="true" aria-labelledby="bc-h">
    <button class="bc-x" type="button" aria-label="Close">×</button>
    <div class="bc-head">
      {thumb && <Image class="bc-thumb" src={thumb} alt="" width={168} height={168} loading="lazy" />}
      <div>
        <p class="bc-eyebrow hand" data-one="Your reader’s summer" data-boat="Your crew’s summer">Your reader’s summer</p>
        <h3 id="bc-h">Lostman’s River: Fishing Guide Experience</h3>
        <p class="bc-price" aria-live="polite"><span class="bc-amount">{price}</span>, once<span class="bc-for" hidden>, for up to five readers</span></p>
      </div>
    </div>
    <ul class="bc-list">
      <li>Read, listen, learn.</li>
      {
        bogo && (
          <li class="bc-bogo" data-bogo-until={bogo.until} data-one={`Buy one, give one: a second Experience to give, free, with a gift card you can send to anyone. Through ${bogo.through}.`} data-boat="Every reader’s link comes with its own gift card to print or send.">
            Buy one, give one: a second Experience to give, free, with a gift card you can send to anyone. Through {bogo.through}.
          </li>
        )
      }
      <li>Opens the minute you pay: a link on screen and in your email. Nothing to install.</li>
      <li class="bc-who" data-one="One reader, on any of your family’s devices. No account, no password." data-boat="Up to five readers, each with their own link on their own device. No account, no password.">One reader, on any of your family’s devices. No account, no password.</li>
    </ul>
    {
      crew && (
        <label class="bc-boat">
          <input class="bc-boat-in" type="checkbox" role="switch" />
          <span class="bc-switch" aria-hidden="true" />
          <span class="bc-boat-text">
            {crew.tag && <span class="bc-tag">{crew.tag}</span>}
            <strong>
              Add the Full Boat bonus <span class="bc-plus mono">{boatPlus}</span>
            </strong>
            <span>Fill your boat with <b>up to five readers</b>: brothers, sisters, cousins, friends. Each one gets their own link, missions, badges and license, and a printable gift card.</span>
          </span>
        </label>
      )
    }
    {
      wild && (
        <div class="bc-wild" data-url={wild.url} data-crew-url={wild.crewUrl} data-price={wild.price}>
          <label class="bc-boat bc-wild-row">
            <input class="bc-boat-in bc-wild-in" type="checkbox" role="switch" />
            <span class="bc-switch" aria-hidden="true" />
            <span class="bc-boat-text">
              <span class="bc-tag">Add-on</span>
              <strong>
                Add Wild Florida <span class="bc-plus mono">+{wild.price}</span>
              </strong>
              <span data-one="Uncle Dan teaches your reader to name Florida’s sharks, snakes, gators, fish and birds on sight." data-boat="Uncle Dan teaches your crew to name Florida’s animals on sight. One add-on covers every reader in the boat.">
                Uncle Dan teaches your reader to name Florida’s sharks, snakes, gators, fish and birds on sight.
              </span>
            </span>
          </label>
          <button class="bc-what" type="button" aria-expanded="false" aria-controls="bc-what-panel">
            What’s this? <span class="bc-what-arrow" aria-hidden="true">▾</span>
          </button>
          <div class="bc-what-panel" id="bc-what-panel" hidden>
            {
              wildPlates.length > 0 && (
                <div class="bc-what-art">
                  {wildPlates.map((p) => (
                    <Image src={p.src!} alt={p.name} width={150} height={150} loading="lazy" />
                  ))}
                </div>
              )
            }
            <p>
              <strong>Wild Florida: Uncle Dan’s field school.</strong> A game that teaches a reader to name Florida’s animals on sight: {wildKinds}.
            </p>
            <ul>
              <li>{wildCount < wildTotal ? `${wildCount} animals in it today, and new ones are added as their plates are painted, until all ${wildTotal} are in.` : `${wildTotal} animals, each with its own painted plate.`}</li>
              <li>One tell-tale for every animal, in Uncle Dan’s words and voice, with the look-alikes side by side: alligator or crocodile, coral snake or scarlet kingsnake, a dolphin’s fin or a shark’s.</li>
              <li>Six ways to play, a logbook, five ranks from Greenhorn to Captain, and a certificate to print.</li>
              <li>Pick the animals by kind, or by the part of Florida you’re in.</li>
              <li>One add-on covers every seat in the boat: your reader, the Experience you give, and a full crew.</li>
            </ul>
            <p class="small">
              <a href={url('/wild-florida/')}>Try the first {wildStarters} animals free</a>
            </p>
          </div>
        </div>
      )
    }
    <div class="bc-promise">
      <strong>No subscription. Nothing renews.</strong>
      <span>30-day refund, no questions asked: email <a href="mailto:help@lostmansriver.com">help@lostmansriver.com</a>.</span>
    </div>
    <p class="bc-total" aria-hidden="true">
      Your total: <strong class="bc-amount2">{price}</strong>, once
    </p>
    <a class="btn btn-primary bc-go" href={site.checkout.url} rel="noopener" data-track="confirm_go">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
      Continue to secure checkout →
    </a>
    <p class="bc-fine small"><strong>Secure checkout by Stripe.</strong> Apple Pay, Link or any card. The total shows before you pay.</p>
    <p class="bc-cad small" hidden>In Canada? Checkout shows the price in Canadian dollars, and that’s what your card is charged.</p>
    <button class="bc-later" type="button">Not yet</button>
    <p class="bc-human small">Made by a mother and son. A real person answers <a href="mailto:help@lostmansriver.com">help@lostmansriver.com</a>.</p>
  </div>
</div>

<script>
  import { track, campaign } from '../scripts/track';
  // The holiday "buy one, give one" offer ends by itself: after its date, everything that
  // mentions it is taken off the page and the ordinary line it replaced comes back.
  for (const el of document.querySelectorAll<HTMLElement>('[data-bogo-until]')) {
    if (Date.now() > Date.parse(el.dataset.bogoUntil!)) {
      el.remove();
      document.querySelectorAll<HTMLElement>('[data-bogo-else]').forEach((e) => (e.hidden = false));
    }
  }
  const bg = document.getElementById('buy-confirm')!;
  const go = bg.querySelector<HTMLAnchorElement>('.bc-go')!;
  let opener: HTMLElement | null = null;
  const page = location.pathname;

  // Canada: Stripe's checkout shows Canadian dollars to Canadian visitors (Adaptive Pricing), so
  // the site says the price is in US dollars and the sheet says what checkout will show. A visitor
  // counts as Canadian by device time zone (Canada-only zones) or a Canada ad code (ends "-ca").
  const CA_ZONES = /^America\/(Toronto|Montreal|Vancouver|Edmonton|Winnipeg|Regina|Swift_Current|Halifax|Glace_Bay|Moncton|Goose_Bay|St_Johns|Whitehorse|Dawson|Dawson_Creek|Fort_Nelson|Creston|Yellowknife|Inuvik|Iqaluit|Rankin_Inlet|Resolute|Cambridge_Bay|Atikokan|Thunder_Bay|Nipigon|Rainy_River|Pangnirtung|Blanc-Sablon)$/;
  let inCanada = false;
  try {
    inCanada = CA_ZONES.test(Intl.DateTimeFormat().resolvedOptions().timeZone || '') || /-ca$/.test(campaign());
  } catch {}
  if (inCanada) {
    const prices = (bg.dataset.prices || bg.dataset.price || '').split('|').filter(Boolean);
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const hits: Text[] = [];
    for (let n = walker.nextNode(); n; n = walker.nextNode()) if (prices.some((p) => n.nodeValue?.includes(p))) hits.push(n as Text);
    // "$29.99" becomes "US$29.99" (and the crew price likewise); one already "US$…" is left as it is
    for (const t of hits)
      for (const p of prices) {
        const us = 'US' + p;
        t.nodeValue = t.nodeValue!.split(us).join('§').split(p).join(us).split('§').join(us);
      }
    bg.querySelector<HTMLElement>('.bc-cad')!.hidden = false;
  }

  // The Full Boat switch: off = the one-reader link the tap came from; on = the Full Crew link with
  // the same ad click / campaign code. The price line, the who-it's-for line and the event follow.
  // The Wild Florida switch adds the add-on to whichever of the two is chosen: four links in all.
  const boat = bg.querySelector<HTMLInputElement>('.bc-boat-in:not(.bc-wild-in)');
  const wildBox = bg.querySelector<HTMLElement>('.bc-wild');
  const wildIn = bg.querySelector<HTMLInputElement>('.bc-wild-in');
  const cents = (v: string) => Math.round(Number(v.replace(/[^0-9.]/g, '')) * 100);
  let oneHref = go.href;
  const paint = () => {
    const on = !!boat?.checked && !!bg.dataset.crewUrl;
    const addOn = !!wildIn?.checked && !!wildBox;
    const target = addOn ? (on ? wildBox!.dataset.crewUrl! : wildBox!.dataset.url!) : on ? bg.dataset.crewUrl! : '';
    let href = oneHref;
    if (target) {
      const u = new URL(target);
      const ref = new URL(oneHref).searchParams.get('client_reference_id');
      if (ref) u.searchParams.set('client_reference_id', ref);
      href = u.toString();
    }
    go.href = href;
    go.dataset.track = on ? 'crew_click' : 'confirm_go';
    go.dataset.trackPage = on ? `${page}:sheet` : page;
    const total = cents(on ? bg.dataset.crewPrice! : bg.dataset.price!) + (addOn ? cents(wildBox!.dataset.price!) : 0);
    // shown twice: under the title, and above Continue where the switches are (the sheet is taller than a phone)
    for (const el of bg.querySelectorAll<HTMLElement>('.bc-amount, .bc-amount2')) el.textContent = (inCanada ? 'US' : '') + '$' + (total / 100).toFixed(2);
    bg.querySelector<HTMLElement>('.bc-for')!.hidden = !on;
    for (const el of bg.querySelectorAll<HTMLElement>('[data-one][data-boat]')) el.textContent = on ? el.dataset.boat! : el.dataset.one!;
    bg.querySelector('.bc-boat:not(.bc-wild-row)')?.classList.toggle('on', on);
    bg.querySelector('.bc-wild-row')?.classList.toggle('on', addOn);
  };
  wildIn?.addEventListener('change', () => {
    track('wild_toggle', { page, on: wildIn.checked ? 1 : 0 });
    paint();
  });
  // "What's this?": the add-on explained, dropped down under its switch
  const what = bg.querySelector<HTMLButtonElement>('.bc-what');
  const whatPanel = bg.querySelector<HTMLElement>('.bc-what-panel');
  const showWhat = (show: boolean) => {
    if (!what || !whatPanel) return;
    whatPanel.hidden = !show;
    what.setAttribute('aria-expanded', String(show));
  };
  what?.addEventListener('click', () => {
    const show = !!whatPanel?.hidden;
    showWhat(show);
    if (show) {
      track('wild_what', { page });
      whatPanel?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
  });
  // Continue with the add-on on: counted beside the usual hand-off event
  go.addEventListener('click', () => {
    if (wildIn?.checked && wildBox) track('wild_go', { page });
  });
  boat?.addEventListener('change', () => {
    track('boat_toggle', { page, on: boat.checked ? 1 : 0 });
    paint();
  });

  function open(from: HTMLAnchorElement) {
    opener = from;
    oneHref = from.href; // carries the ad click / campaign code track.ts put on the tapped link
    if (boat) boat.checked = false; // every opening starts at the one-reader price
    if (wildIn) wildIn.checked = from.dataset.wild === '1'; // on only when the tap came from the Wild Florida page
    showWhat(false);
    paint();
    bg.hidden = false;
    document.documentElement.classList.add('bc-open');
    go.focus();
  }
  function close(why: string) {
    if (bg.hidden) return;
    bg.hidden = true;
    document.documentElement.classList.remove('bc-open');
    track('confirm_close', { page });
    opener?.focus();
  }
  // a Buy tap anywhere on the page opens the sheet (plain left clicks only; modifier clicks and
  // middle clicks keep their browser meaning and go straight to Stripe)
  document.addEventListener('click', (e) => {
    if (bg.dataset.sheet !== 'on') return; // sheet switched off in site.config: Buy goes straight to Stripe
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="https://buy.stripe.com/"]');
    if (!a || bg.contains(a) || a.dataset.direct || a.dataset.pair) return; // the crew goes straight to Stripe
    e.preventDefault();
    open(a);
  });
  bg.querySelector('.bc-x')!.addEventListener('click', () => close('x'));
  bg.querySelector('.bc-later')!.addEventListener('click', () => close('later'));
  bg.addEventListener('click', (e) => {
    if (e.target === bg) close('backdrop');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close('esc');
  });
  // back from Stripe: a page restored from the back/forward cache comes back with the sheet
  // still open and the page scroll-locked. Put it away quietly (not a confirm_close).
  addEventListener('pageshow', (e) => {
    if (!e.persisted || bg.hidden) return;
    bg.hidden = true;
    document.documentElement.classList.remove('bc-open');
  });
</script>

<style is:global>
  html.bc-open,
  html.bc-open body {
    overflow: hidden;
  }
</style>

<style>
  .bc-bg {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: color-mix(in srgb, var(--ink) 50%, transparent);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .bc-bg[hidden] {
    display: none;
  }
  .bc {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: 92dvh;
    overflow: auto;
    background: var(--paper);
    color: var(--ink);
    border-radius: 18px 18px 0 0;
    padding: 1.1rem 1.2rem calc(1rem + env(safe-area-inset-bottom));
    box-shadow: var(--shadow);
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 820px) {
    .bc-bg {
      align-items: center;
    }
    .bc {
      border-radius: 16px;
      padding: 1.4rem 1.5rem 1.2rem;
    }
  }
  .bc-x {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--paper-2);
    color: var(--ink);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .bc-head {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding-right: 2.2rem;
  }
  .bc-thumb {
    width: 84px;
    height: 84px;
    object-fit: cover;
    border-radius: 10px;
  }
  .bc-eyebrow {
    margin: 0;
    color: var(--sunrise-ink);
    font-size: 1.15rem;
    line-height: 1.1;
  }
  .bc h3 {
    margin: 0.1rem 0 0.15rem;
    font-size: 1.1rem;
    line-height: 1.25;
  }
  .bc-price {
    margin: 0;
    color: var(--sunrise-ink);
    font-weight: 700;
  }
  .bc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .bc-list li {
    padding-left: 1.3rem;
    position: relative;
  }
  .bc-list li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--sunrise);
  }
  /* the Full Boat bonus: a whole-row switch */
  .bc-boat {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    padding: 0.75rem 0.85rem;
    border: 2px dashed color-mix(in srgb, var(--sunrise) 75%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--sunrise) 8%, transparent);
    cursor: pointer;
  }
  .bc-boat.on {
    border-style: solid;
    border-color: var(--mangrove);
    background: color-mix(in srgb, var(--mangrove) 10%, transparent);
  }
  .bc-bogo {
    font-weight: 700;
    color: var(--mangrove);
  }
  .bc-boat-in {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .bc-switch {
    position: relative;
    width: 46px;
    height: 28px;
    margin-top: 0.1rem;
    border-radius: 999px;
    background: var(--oyster);
    transition: background 0.15s;
  }
  .bc-switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
    transition: transform 0.15s;
  }
  .bc-boat-in:checked + .bc-switch {
    background: var(--mangrove);
  }
  .bc-boat-in:checked + .bc-switch::after {
    transform: translateX(18px);
  }
  .bc-boat-in:focus-visible + .bc-switch {
    outline: 2px solid var(--sunrise);
    outline-offset: 2px;
  }
  .bc-boat-text {
    display: grid;
    gap: 0.2rem;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .bc-boat-text strong {
    font-size: 1rem;
    color: var(--ink);
  }
  .bc-plus {
    color: var(--sunrise-ink);
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .bc-tag {
    justify-self: start;
    padding: 0.1rem 0.55rem 0.12rem;
    border-radius: 999px;
    background: var(--mangrove);
    color: var(--paper);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  /* the Wild Florida add-on: the same switch row, with "What's this?" under it */
  .bc-wild {
    display: grid;
    gap: 0.35rem;
  }
  .bc-what {
    justify-self: start;
    margin-left: 0.2rem;
    padding: 0.15rem 0.2rem;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.92rem;
    color: var(--mangrove);
    text-decoration: underline;
    cursor: pointer;
  }
  .bc-what-arrow {
    display: inline-block;
    transition: transform 0.15s;
  }
  .bc-what[aria-expanded='true'] .bc-what-arrow {
    transform: rotate(180deg);
  }
  .bc-what-panel {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem 0.85rem;
    background: var(--paper-2);
    border: 1px solid var(--oyster);
    border-radius: 10px;
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .bc-what-panel[hidden] {
    display: none;
  }
  .bc-what-panel p {
    margin: 0;
  }
  .bc-what-panel ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }
  .bc-what-art {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }
  .bc-what-art img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    background: var(--paper);
    border: 1px solid var(--oyster);
    border-radius: 8px;
  }
  .bc-promise {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.9rem;
    background: var(--paper-2);
    border: 1px solid var(--oyster);
    border-radius: 10px;
    font-size: 0.95rem;
  }
  .bc-promise strong {
    color: var(--mangrove);
  }
  .bc-total {
    margin: 0 0 -0.35rem;
    text-align: center;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .bc-total strong {
    color: var(--sunrise-ink);
  }
  .bc-go {
    justify-content: center;
    gap: 0.45rem;
    font-size: 1.05rem;
    width: 100%;
  }
  .bc-fine {
    margin: -0.3rem 0 0;
    text-align: center;
    color: var(--ink-soft);
  }
  .bc-cad {
    margin: -0.4rem 0 0;
    text-align: center;
    color: var(--ink-soft);
  }
  .bc-cad[hidden] {
    display: none;
  }
  .bc-later {
    background: none;
    border: 0;
    padding: 0.2rem;
    font: inherit;
    color: var(--mangrove);
    text-decoration: underline;
    cursor: pointer;
    justify-self: center;
  }
  .bc-human {
