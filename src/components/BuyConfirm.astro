---
// The confirm step between a Buy tap and Stripe: one sheet that says what they get, how it
// arrives and the promise, then "Continue to secure checkout". Every Buy link keeps its real
// Stripe href (a new tab or no JS still reaches checkout); this script intercepts the tap,
// fires the usual buy_click beacon (track.ts, capture phase, runs first), and opens the sheet.
// Measured both ways: confirm_go (Continue) and confirm_close (dismissed). Added 2026-11-07
// after Bedside Stories found the bare Payment Link hand-off was where buyers leaked.
import { Image } from 'astro:assets';
import { artImage } from '@lib/images';
import site from '../../site.config.mjs';
const thumb = artImage('tiles', 'app-hero');
const price = site.checkout.price;
---

<div class="bc-bg" id="buy-confirm" hidden>
  <div class="bc" role="dialog" aria-modal="true" aria-labelledby="bc-h">
    <button class="bc-x" type="button" aria-label="Close">×</button>
    <div class="bc-head">
      {thumb && <Image class="bc-thumb" src={thumb} alt="" width={168} height={168} loading="lazy" />}
      <div>
        <p class="bc-eyebrow hand">Your reader’s summer</p>
        <h3 id="bc-h">Lostman’s River: Fishing Guide Experience</h3>
        <p class="bc-price">{price}, once</p>
      </div>
    </div>
    <ul class="bc-list">
      <li>The whole novel, <em>Escape to Lostman’s River</em>, to read and hear on their own phone or tablet, with 23 missions, 23 field missions, the printable Field Journal and the Assistant Fishing Guide license.</li>
      <li>Arrives the moment you pay: a link on screen and in your email. Nothing to install; it opens in the browser on any device.</li>
      <li>One price for the whole household. No account, no password, nothing for a child to sign up for.</li>
    </ul>
    <div class="bc-promise">
      <strong>No subscription. Nothing renews.</strong>
      <span>30-day refund, no questions asked: email <a href="mailto:help@lostmansriver.com">help@lostmansriver.com</a>.</span>
    </div>
    <a class="btn btn-primary bc-go" href={site.checkout.url} rel="noopener" data-track="confirm_go">Continue to secure checkout →</a>
    <p class="bc-fine small muted">🔒 Secure checkout by Stripe. The total shows before you pay.</p>
    <p class="bc-safari small" hidden>Want Apple Pay? <a class="bc-safari-a" href="#" data-track="safari_open">Open this page in Safari</a></p>
    <button class="bc-later" type="button">Not yet</button>
    <p class="bc-human small">Made by a mother and son. A real person answers <a href="mailto:help@lostmansriver.com">help@lostmansriver.com</a>.</p>
  </div>
</div>

<script>
  import { track } from '../scripts/track';
  const bg = document.getElementById('buy-confirm')!;
  const go = bg.querySelector<HTMLAnchorElement>('.bc-go')!;
  let opener: HTMLElement | null = null;
  const page = location.pathname;

  // inside the Facebook or Instagram app on an iPhone/iPad, Apple Pay is usually unavailable;
  // offer to reopen this page in Safari (x-safari-https: needs iOS 17 or later)
  const ua = navigator.userAgent;
  const inApp = /FBAN|FBAV|FB_IAB|Instagram/i.test(ua) && /iPhone|iPad|iPod/i.test(ua);
  if (inApp) {
    const line = bg.querySelector<HTMLElement>('.bc-safari')!;
    const a = line.querySelector<HTMLAnchorElement>('.bc-safari-a')!;
    a.href = 'x-safari-' + location.href.replace(/^http:/, 'https:');
    a.dataset.trackPage = page;
    line.hidden = false;
  }

  function open(from: HTMLAnchorElement) {
    opener = from;
    go.href = from.href; // carries the ad click / campaign code track.ts put on the tapped link
    go.dataset.trackPage = page;
    bg.hidden = false;
    document.documentElement.classList.add('bc-open');
    go.focus();
  }
  function close(why: string) {
    if (bg.hidden) return;
    bg.hidden = true;
    document.documentElement.classList.remove('bc-open');
    track('confirm_close', { page });
    opener?.focus();
  }
  // a Buy tap anywhere on the page opens the sheet (plain left clicks only; modifier clicks and
  // middle clicks keep their browser meaning and go straight to Stripe)
  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="https://buy.stripe.com/"]');
    if (!a || bg.contains(a)) return;
    e.preventDefault();
    open(a);
  });
  bg.querySelector('.bc-x')!.addEventListener('click', () => close('x'));
  bg.querySelector('.bc-later')!.addEventListener('click', () => close('later'));
  bg.addEventListener('click', (e) => {
    if (e.target === bg) close('backdrop');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close('esc');
  });
</script>

<style is:global>
  html.bc-open,
  html.bc-open body {
    overflow: hidden;
  }
</style>

<style>
  .bc-bg {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: color-mix(in srgb, var(--ink) 50%, transparent);
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .bc-bg[hidden] {
    display: none;
  }
  .bc {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: 92dvh;
    overflow: auto;
    background: var(--paper);
    color: var(--ink);
    border-radius: 18px 18px 0 0;
    padding: 1.1rem 1.2rem calc(1rem + env(safe-area-inset-bottom));
    box-shadow: var(--shadow);
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 820px) {
    .bc-bg {
      align-items: center;
    }
    .bc {
      border-radius: 16px;
      padding: 1.4rem 1.5rem 1.2rem;
    }
  }
  .bc-x {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--paper-2);
    color: var(--ink);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .bc-head {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding-right: 2.2rem;
  }
  .bc-thumb {
    width: 84px;
    height: 84px;
    object-fit: cover;
    border-radius: 10px;
  }
  .bc-eyebrow {
    margin: 0;
    color: var(--sunrise-ink);
    font-size: 1.15rem;
    line-height: 1.1;
  }
  .bc h3 {
    margin: 0.1rem 0 0.15rem;
    font-size: 1.1rem;
    line-height: 1.25;
  }
  .bc-price {
    margin: 0;
    color: var(--sunrise-ink);
    font-weight: 700;
  }
  .bc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .bc-list li {
    padding-left: 1.3rem;
    position: relative;
  }
  .bc-list li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--sunrise);
  }
  .bc-promise {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0.9rem;
    background: var(--paper-2);
    border: 1px solid var(--oyster);
    border-radius: 10px;
    font-size: 0.95rem;
  }
  .bc-promise strong {
    color: var(--mangrove);
  }
  .bc-go {
    justify-content: center;
    font-size: 1.05rem;
    width: 100%;
  }
  .bc-fine {
    margin: -0.3rem 0 0;
    text-align: center;
  }
  .bc-safari {
    margin: -0.4rem 0 0;
    text-align: center;
  }
  .bc-safari[hidden] {
    display: none;
  }
  .bc-later {
    background: none;
    border: 0;
    padding: 0.2rem;
    font: inherit;
    color: var(--mangrove);
    text-decoration: underline;
    cursor: pointer;
    justify-self: center;
  }
  .bc-human {
    margin: 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--oyster);
    text-align: center;
    color: var(--ink-soft);
  }
</style>
