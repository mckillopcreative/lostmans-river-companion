---
// The mother-and-son card: the whole photo (a portrait, shown uncropped with soft corners)
// beside the headline and bio from site.config. Stacks on a phone, two columns from 640px.
import { Image } from 'astro:assets';
import { photoImages } from '@lib/images';
import site from '../../site.config.mjs';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const photo = photoImages.get('authors.jpg') ?? photoImages.get('authors.png') ?? null;
---

<section class:list={['authors-card', { compact, 'has-photo': !!photo }]} aria-labelledby="authors-h">
  {
    photo && (
      <div class="portrait">
        <Image src={photo} alt="John McKillop and his mother Linda, the authors" width={photo.width} height={photo.height} loading="lazy" />
      </div>
    )
  }
  <div class="text">
    <p id="authors-h" class="headline">{site.authorsHeadline}</p>
    <p class="bio" set:html={site.authorsBio} />
  </div>
</section>

<style>
  .authors-card {
    background: var(--paper-2);
    border: 1px solid color-mix(in srgb, var(--oyster) 60%, transparent);
    border-radius: 14px;
    padding: 1.5rem;
    max-width: 760px;
    margin-inline: auto;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    text-align: center;
  }
  @media (min-width: 640px) {
    .authors-card.has-photo {
      grid-template-columns: 200px 1fr;
      align-items: center;
      gap: 1.75rem;
      text-align: left;
      justify-items: stretch;
      padding: 1.75rem 2rem;
    }
    .authors-card.has-photo .portrait {
      max-width: none;
    }
  }
  .portrait {
    width: 200px;
    max-width: 70%;
    border-radius: 12px;
    overflow: hidden;
    border: 3px solid var(--sunrise);
    box-shadow: 0 8px 20px -10px rgb(31 42 46 / 0.45);
    background: var(--paper);
  }
  .portrait img {
    display: block;
    width: 100%;
    height: auto;
  }
  .headline {
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.25;
    color: var(--mangrove);
    margin: 0 0 0.6rem;
    text-wrap: balance;
  }
  .bio {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }
  .bio :global(em) {
    color: var(--sunrise-ink);
    font-style: italic;
  }
  .compact {
    padding: 1.25rem 1rem;
  }
  @media (min-width: 640px) {
    .compact.has-photo {
      grid-template-columns: 140px 1fr;
      padding: 1.25rem 1.5rem;
    }
  }
  .compact .portrait {
    width: 140px;
  }
  .compact .headline {
    font-size: 1.05rem;
  }
  .compact .bio {
    font-size: 0.9rem;
  }
</style>
