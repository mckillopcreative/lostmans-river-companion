---
// "Hook the Experience": a sticky button, bottom right, that appears once the reader has scrolled
// a screen down on a page without a purchase key. Same destination as every Buy button, so the
// confirm sheet opens and the beacons fire the same way. Hidden for key holders (.has-key), except
// on the landing page since 2026-11-23 (John: people who bought may buy more), class hook-keep.
// 2026-11-27 (John): on the landing page it shows the moment the page loads, with no scrolling
// ("people have to scroll for like 5 seconds to even know how to purchase"). It is rendered
// visible there, so it does not wait for the script. Other pages keep the one-screen scroll rule.
// Later the same day (John: "a hook the experience sticky pill that goes to Amazon? Then flip it
// closer to Christmas"): until site.config → sticky.amazonUntil the pill goes to the Amazon
// paperback (amazon_click "<page>:sticky"), with no price and no holiday pill, because both belong
// to the digital copy and Amazon sets its own price. After that moment the script swaps in the
// digital pill below (the same one as before), so the flip needs no deploy.
import site from '../../site.config.mjs';
import { buyHref, buyTrack, isOpen, price, bogo } from '@lib/buy';
// 2026-11-16 (John): while the holiday "buy one, give one" runs, the same small pill that sits on
// the other Buy buttons rides on this one's top-left shoulder (it removes itself after the date,
// like every [data-bogo-until]; BuyConfirm.astro does that)
// 2026-11-15: back to the plain Buy link ($24.99), so it opens the confirm sheet like every other
// Buy button; the crew is the sheet's Full Boat toggle, and nobody lands cold on a $39.99 checkout
const href = buyHref;
const track = buyTrack;
const keep = Astro.url.pathname === '/';
const until = (site as { sticky?: { amazonUntil?: string } }).sticky?.amazonUntil;
// built after the date: the Amazon pill is not built in at all
const amz = !!site.amazonCrewPass && !!until && Date.now() < Date.parse(until);
---

{
  amz && (
    <a class:list={['hook-btn', 'hook-amz', 'btn', 'btn-primary', { 'hook-keep': keep }]} href={site.buyUrl} rel="noopener" data-track="amazon_click" data-track-page={`${Astro.url.pathname}:sticky`} data-amz-until={until} hidden={!keep} aria-label="Hook the Experience: the paperback on Amazon">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v9a4 4 0 0 0 8 0" /><path d="M20 12a2 2 0 1 0-4 0" /><circle cx="12" cy="3" r="1" /></svg>
      Hook the Experience
      <span class="hook-price mono">on Amazon →</span>
    </a>
  )
}
<a class:list={['hook-btn', 'hook-exp', 'btn', 'btn-primary', { 'hook-keep': keep }]} href={href} rel="noopener" data-track={track} data-track-page={`${Astro.url.pathname}:sticky`} hidden={amz || !keep} aria-label={isOpen ? `Hook the Experience, ${price}${bogo ? ', buy one, give one' : ''}` : 'Hook the Experience'}>
  {bogo && <span class="hook-bogo" data-bogo-until={bogo.until} aria-hidden="true">Buy one · Give one</span>}
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v9a4 4 0 0 0 8 0" /><path d="M20 12a2 2 0 1 0-4 0" /><circle cx="12" cy="3" r="1" /></svg>
  Hook the Experience
  {isOpen && <span class="hook-price mono">{price}</span>}
</a>

<script>
  // which pill is on duty: the Amazon one until its date, then the digital one
  const amz = document.querySelector<HTMLAnchorElement>('.hook-amz');
  const exp = document.querySelector<HTMLAnchorElement>('.hook-exp');
  let btn = exp;
  if (amz) {
    if (Date.now() < Date.parse(amz.dataset.amzUntil || '')) {
      btn = amz;
      exp?.remove();
    } else {
      amz.remove();
      if (exp?.classList.contains('hook-keep')) exp.hidden = false;
    }
  }
  // the landing page's button (hook-keep) is already showing and stays; everywhere else it waits for a scroll
  if (btn && !btn.classList.contains('hook-keep') && !document.documentElement.classList.contains('has-key')) {
    let shown = false;
    const check = () => {
      const past = window.scrollY > window.innerHeight * 0.8;
      if (past !== shown) {
        shown = past;
        btn!.hidden = !past;
      }
    };
    addEventListener('scroll', check, { passive: true });
    check();
  }
</script>

<style>
  .hook-btn {
    position: fixed;
    right: max(14px, env(safe-area-inset-right));
    bottom: max(14px, env(safe-area-inset-bottom));
    z-index: 900;
    gap: 0.45rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.22);
    font-size: 0.98rem;
    animation: hook-in 0.3s ease-out;
  }
  /* the holiday pill, on the button's top-left shoulder */
  .hook-bogo {
    position: absolute;
    left: 0.9rem;
    top: -0.72rem;
    padding: 0.16rem 0.65rem 0.18rem;
    border-radius: 999px;
    background: var(--mangrove);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
  }
  .hook-price {
    font-size: 0.8em;
    opacity: 0.9;
  }
  .hook-btn[hidden] {
    display: none;
  }
  :global(html.has-key) .hook-btn:not(.hook-keep),
  :global(html.bc-open) .hook-btn,
  :global(html.pager-open) .hook-btn {
    display: none;
  }
  @keyframes hook-in {
    from {
      transform: translateY(12px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media print {
    .hook-btn {
      display: none;
    }
  }
</style>
