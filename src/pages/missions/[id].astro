---
// One mission. The interaction type comes from data/missions.json; checking and saving run on the device.
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import ChapterPill from '@components/ChapterPill.astro';
import { missions, chapterByN, fishById, placeById, type Mission } from '@lib/data';
import { artImage } from '@lib/images';
import { url } from '@lib/url';
import site from '../../../site.config.mjs';

export function getStaticPaths() {
  return missions.map((m) => ({ params: { id: m.id }, props: { m } }));
}
const { m } = Astro.props as { m: Mission };
const idx = missions.findIndex((x) => x.id === m.id);
const next = missions[idx + 1];
const spot = artImage('chapters', `ch-${String(m.chapter).padStart(2, '0')}`);
const badgeArt = m.badge ? artImage('emblems', `badge-${m.badge}`) : null;
const imageOptions =
  m.type === 'fish'
    ? m.options!.map((id) => ({ id, label: fishById.get(id)!.common, img: artImage('fish', id) }))
    : m.type === 'place'
      ? m.options!.map((id) => ({ id, label: placeById.get(id)!.name, img: artImage('places', id) }))
      : null;
// Everything the client script needs, without the answer text leaking into the markup where a kid can read it first.
const payload = { id: m.id, type: m.type, answer: m.answer ?? null, accept: m.accept ?? null, order: m.items ?? null, badge: m.badge ?? null, next: next ? url(`/missions/${next.id}/`) : url('/license/') };
---

<Base title={`Mission ${m.chapter}: ${m.title}`} description={m.prompt}>
  <article class="frame">
    <div class="wrap">
      <p class="crumbs small"><a href={url('/missions/')}>← Your summer</a></p>
      <header class="mi-head">
        {spot && <Image class="mi-spot art" src={spot} alt="" width={240} height={240} loading="eager" />}
        <div>
          <p class="eyebrow">Mission {m.chapter} · {m.skill}</p>
          <h1>{m.title}</h1>
          <p class="small muted">
            From <ChapterPill n={m.chapter} /> <a href={url(`/ch/${m.chapter}/`)}>{chapterByN.get(m.chapter)?.title}</a>
          </p>
        </div>
      </header>

      <p class="prompt">{m.prompt}</p>

      {
        site.gate?.live && m.chapter > 1 && (
          <div class="mission-lock" id="mission-lock">
            <p class="hand mission-lock-h">Mission {m.chapter} is part of the Full Experience</p>
            <p class="small">Mission 1 is free. The other 22, the three badges and the Assistant Guide license come with the Experience, along with every chapter read aloud.</p>
            <p class="cluster">
              <a class="btn btn-primary" href={site.checkout.url} rel="noopener" data-track="buy_click" data-track-page={`mission-${m.chapter}`}>
                Get the Full Experience {site.checkout.price}
              </a>
              <a class="small" href={url('/restore/')}>Already bought it?</a>
            </p>
          </div>
        )
      }
      <div class="play" id="play" data-mission={JSON.stringify(payload)} data-locked={site.gate?.live && m.chapter > 1 ? '1' : undefined}>
        {
          (m.type === 'choice' || m.type === 'decide') && (
            <ul class="choices">
              {m.options!.map((o, i) => (
                <li>
                  <button type="button" class="choice" data-i={i}>
                    {o}
                  </button>
                </li>
              ))}
            </ul>
          )
        }
        {
          imageOptions && (
            <ul class="choices img-choices">
              {imageOptions.map((o, i) => (
                <li>
                  <button type="button" class="choice img-choice art" data-i={i} aria-label={o.label}>
                    {o.img && <Image src={o.img} alt="" width={400} sizes="(min-width: 600px) 240px, 45vw" loading="lazy" />}
                    <span class="img-label">{o.label}</span>
                  </button>
                </li>
              ))}
            </ul>
          )
        }
        {
          m.type === 'order' && (
            <div class="order">
              <p class="small muted">Tap the steps in order. Tap a chosen step to put it back.</p>
              <ul class="pool" id="pool">
                {m.items!.map((it, i) => (
                  <li>
                    <button type="button" class="chip" data-i={i}>
                      {it}
                    </button>
                  </li>
                ))}
              </ul>
              <ol class="picked" id="picked" aria-label="Your order" />
              <button type="button" class="btn btn-primary" id="check-order" disabled>
                Check
              </button>
            </div>
          )
        }
        {
          (m.type === 'text' || m.type === 'sign') && (
            <form class="textform" id="textform">
              <label class="sr-only" for="answer">{m.type === 'sign' ? 'Your name' : 'Your answer'}</label>
              <input id="answer" type="text" autocomplete={m.type === 'sign' ? 'given-name' : 'off'} maxlength="40" placeholder={m.type === 'sign' ? 'Your first name' : 'Write it here'} required />
              <button class="btn btn-primary" type="submit">
                {m.type === 'sign' ? 'Sign' : 'Log it'}
              </button>
            </form>
          )
        }
      </div>

      <div class="result" id="result" hidden>
        <p class="hand result-word" id="result-word" />
        <p id="result-explain">{m.explain}</p>
        {
          badgeArt && (
            <div class="badge-earned" id="badge-earned" hidden>
              <Image src={badgeArt} alt={`${m.badge} badge`} width={200} height={200} />
              <p class="hand">Badge earned</p>
            </div>
          )
        }
        <p class="cluster">
          <a class="btn btn-primary" id="next-link" href={payload.next}>
            {next ? `Next: Mission ${next.chapter} →` : 'Print your license →'}
          </a>
          <a class="btn" href={url(`/ch/${m.chapter}/`)}>Back to the chapter</a>
        </p>
      </div>

      <section class="field" id="field" aria-labelledby="field-h" data-id={m.id} data-locked={site.gate?.live && m.chapter > 1 ? '1' : undefined}>
        <p class="eyebrow field-eyebrow">Do it for real · Field mission {m.chapter}</p>
        <h2 id="field-h" class="field-title">{m.field.title}</h2>
        <p class="field-do">{m.field.do}</p>
        <dl class="field-facts">
          <div>
            <dt class="mono">You need</dt>
            <dd>{m.field.need}{m.field.adult && <strong class="field-adult"> · a grown-up with you</strong>}</dd>
          </div>
          {
            m.field.home && (
              <div>
                <dt class="mono">Nowhere near water?</dt>
                <dd>{m.field.home}</dd>
              </div>
            )
          }
          <div>
            <dt class="mono">In your Field Journal</dt>
            <dd>{m.field.log}</dd>
          </div>
        </dl>
        {
          m.field.link && (
            <p class="small">
              <a href={m.field.link.href.startsWith('/') ? url(m.field.link.href) : m.field.link.href} rel={m.field.link.href.startsWith('/') ? undefined : 'noopener'}>
                {m.field.link.label} →
              </a>
            </p>
          )
        }
        <div class="signoff" id="signoff">
          <button type="button" class="btn btn-primary" id="signoff-ask">Captain’s sign-off</button>
          <div class="signoff-confirm" id="signoff-confirm" hidden>
            <p><strong>Grown-up:</strong> did you see this field mission done?</p>
            <p class="cluster">
              <button type="button" class="btn btn-primary" id="signoff-yes">Yes, I saw it. Signed.</button>
              <button type="button" class="btn" id="signoff-no">Not yet</button>
            </p>
          </div>
          <p class="stamp hand" id="signoff-stamp" hidden></p>
        </div>
        <p class="small muted">
          Print the <a href={url('/field-journal/')}>Field Journal</a> to log it on paper, with a line for the grown-up to sign.
        </p>
      </section>
    </div>
  </article>

  <script>
    import { getKey } from '../../scripts/access';
    // missions 2–23 open on a device holding a purchase key; the page still renders for search and preview
    if (getKey()) document.getElementById('mission-lock')?.remove();
    else document.querySelectorAll<HTMLElement>('#play[data-locked], #field[data-locked]').forEach((el) => el.setAttribute('inert', ''));
  </script>

  <script>
    import { load, signField } from '../../scripts/progress';
    import { track } from '../../scripts/track';
    const field = document.getElementById('field')!;
    const id = field.dataset.id!;
    const ask = document.getElementById('signoff-ask')!;
    const confirm = document.getElementById('signoff-confirm')!;
    const stamp = document.getElementById('signoff-stamp')!;
    const show = (date: string) => {
      const d = new Date(date + 'T12:00:00').toLocaleDateString(undefined, { month: 'long', day: 'numeric' });
      stamp.textContent = `Signed off by the captain, ${d}`;
      stamp.hidden = false;
      ask.hidden = true;
      confirm.hidden = true;
      field.classList.add('is-signed');
    };
    const signed = load().field[id];
    if (signed) show(signed);
    ask.addEventListener('click', () => {
      ask.hidden = true;
      confirm.hidden = false;
    });
    document.getElementById('signoff-no')!.addEventListener('click', () => {
      confirm.hidden = true;
      ask.hidden = false;
    });
    document.getElementById('signoff-yes')!.addEventListener('click', () => {
      const p = signField(id);
      track('field_signoff', { id });
      show(p.field[id]);
    });
  </script>

  <script>
    import { completeMission, setName } from '../../scripts/progress';
    import { track } from '../../scripts/track';
    const play = document.getElementById('play')!;
    const data = JSON.parse(play.dataset.mission!) as { id: string; type: string; answer: number | null; accept: string[] | null; order: string[] | null; badge: string | null; next: string };
    const result = document.getElementById('result')!;
    const word = document.getElementById('result-word')!;
    const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9 ]/g, '').replace(/\s+/g, ' ').trim();

    function finish(ok: boolean, msg: string) {
      word.textContent = msg;
      result.hidden = false;
      if (ok) {
        completeMission(data.id, data.badge);
        track('mission_complete', { id: data.id });
        if (data.badge) track('badge_earned', { badge: data.badge });
        const b = document.getElementById('badge-earned');
        if (b) b.hidden = false;
        play.classList.add('is-done');
      }
      result.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // choice / decide / fish / place
    play.querySelectorAll<HTMLButtonElement>('.choice').forEach((btn) => {
      btn.addEventListener('click', () => {
        const i = Number(btn.dataset.i);
        if (data.type === 'decide') {
          play.querySelectorAll('.choice').forEach((b) => b.classList.toggle('picked', b === btn));
          finish(true, i === 0 ? 'Same call Matt made.' : 'A tournament call. Here’s what Matt did:');
          return;
        }
        if (i === data.answer) {
          btn.classList.add('right');
          play.querySelectorAll<HTMLButtonElement>('.choice').forEach((b) => (b.disabled = true));
          finish(true, 'That’s it.');
        } else {
          btn.classList.add('wrong');
          btn.disabled = true;
          word.textContent = 'Not that one. Try again.';
          result.hidden = false;
          document.getElementById('result-explain')!.hidden = true;
          document.getElementById('next-link')!.hidden = true;
        }
      });
    });
    // when they get it right, show the explanation and the next link again
    const explainEl = document.getElementById('result-explain')!;
    const nextEl = document.getElementById('next-link')!;
    const obs = new MutationObserver(() => {
      if (play.classList.contains('is-done')) {
        explainEl.hidden = false;
        nextEl.hidden = false;
      }
    });
    obs.observe(play, { attributes: true, attributeFilter: ['class'] });

    // order
    if (data.type === 'order') {
      const pool = document.getElementById('pool')!;
      const picked = document.getElementById('picked')!;
      const check = document.getElementById('check-order') as HTMLButtonElement;
      // shuffle the pool
      const lis = Array.from(pool.children);
      lis.sort(() => Math.random() - 0.5).forEach((li) => pool.appendChild(li));
      const chosen: number[] = [];
      const render = () => {
        picked.innerHTML = '';
        chosen.forEach((i, pos) => {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'chip picked-chip';
          b.textContent = `${pos + 1}. ${data.order![i]}`;
          b.addEventListener('click', () => {
            chosen.splice(pos, 1);
            pool.querySelector<HTMLButtonElement>(`.chip[data-i="${i}"]`)!.parentElement!.hidden = false;
            render();
          });
          li.appendChild(b);
          picked.appendChild(li);
        });
        check.disabled = chosen.length !== data.order!.length;
      };
      pool.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          chosen.push(Number(chip.dataset.i));
          chip.parentElement!.hidden = true;
          render();
        });
      });
      check.addEventListener('click', () => {
        const ok = chosen.every((v, i) => v === i);
        if (ok) finish(true, 'In order. Nicely done.');
        else {
          word.textContent = 'Not quite. Tap a step to put it back and try again.';
          result.hidden = false;
          explainEl.hidden = true;
          nextEl.hidden = true;
        }
      });
    }

    // text / sign
    const form = document.getElementById('textform') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (document.getElementById('answer') as HTMLInputElement).value;
      if (data.type === 'sign') {
        if (!v.trim()) return;
        setName(v);
        finish(true, `Signed, ${v.trim()}.`);
        return;
      }
      const ok = (data.accept ?? []).some((a) => norm(a) === norm(v));
      if (ok) finish(true, 'Logged.');
      else {
        word.textContent = 'Not the name in the log. Think back to the chapter.';
        result.hidden = false;
        explainEl.hidden = true;
        nextEl.hidden = true;
      }
    });
  </script>
</Base>

<style>
  .mission-lock {
    margin: 1rem 0;
    padding: 1rem 1.1rem;
    background: var(--paper-2);
    border: 1px solid color-mix(in srgb, var(--oyster) 60%, transparent);
    border-left: 4px solid var(--sunrise);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .mission-lock-h {
    font-size: 1.35rem;
    color: var(--sunrise-ink);
    margin: 0 0 0.3rem;
  }
  #play[inert],
  #field[inert] {
    opacity: 0.45;
    filter: grayscale(0.4);
  }
  .field {
    margin-top: 2rem;
    padding: 1.1rem 1.25rem 0.75rem;
    background: color-mix(in srgb, var(--mangrove) 8%, var(--paper-2));
    border: 1.5px dashed color-mix(in srgb, var(--mangrove) 55%, transparent);
    border-radius: var(--radius);
  }
  .field-eyebrow {
    color: var(--mangrove);
  }
  .field-title {
    margin: 0.1rem 0 0.5rem;
    color: var(--mangrove);
  }
  .field-do {
    font-size: 1.1rem;
  }
  .field-facts {
    display: grid;
    gap: 0.6rem;
    margin: 0.75rem 0;
  }
  .field-facts dt {
    font-size: 0.7rem;
    color: var(--sunrise-ink);
  }
  .field-facts dd {
    margin: 0.1rem 0 0;
  }
  .field-adult {
    color: var(--mangrove);
  }
  .signoff {
    margin: 1rem 0 0.75rem;
  }
  .signoff-confirm {
    padding: 0.75rem 1rem;
    background: var(--paper-2);
    border-left: 4px solid var(--sunrise);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .signoff-confirm p {
    margin: 0 0 0.5rem;
  }
  .stamp {
    display: inline-block;
    margin: 0;
    padding: 0.35rem 0.9rem;
    font-size: 1.35rem;
    color: var(--mangrove);
    border: 2.5px solid var(--mangrove);
    border-radius: 6px;
    transform: rotate(-2deg);
  }
  .signoff [hidden] {
    display: none !important;
  }
  .crumbs {
    margin-bottom: 0.5rem;
  }
  .mi-head {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .mi-spot {
    width: 96px;
    height: 96px;
    object-fit: contain;
    flex: none;
  }
  .prompt {
    font-size: 1.2rem;
    margin: 1.25rem 0 1rem;
  }
  .choices {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .choice {
    width: 100%;
    text-align: left;
    font: inherit;
    font-size: 1.05rem;
    padding: 0.8rem 1rem;
    min-height: 52px;
    border-radius: var(--radius);
    border: 1.5px solid var(--oyster);
    background: var(--paper-2);
    color: var(--ink);
    cursor: pointer;
  }
  .choice:hover:not(:disabled) {
    border-color: var(--gulf);
  }
  .choice.right,
  .choice.picked {
    border-color: var(--sunrise);
    background: color-mix(in srgb, var(--sunrise) 18%, var(--paper-2));
  }
  .choice.wrong {
    opacity: 0.5;
    text-decoration: line-through;
  }
  .img-choices {
    grid-template-columns: 1fr 1fr;
  }
  .img-choice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem;
  }
  .img-choice img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }
  .img-label {
    font-weight: 600;
    color: var(--mangrove);
    font-size: 0.95rem;
    text-align: center;
  }
  .play.is-done .img-label {
    visibility: visible;
  }
  .pool,
  .picked {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .picked {
    min-height: 44px;
    border: 1.5px dashed var(--oyster);
    border-radius: var(--radius);
    padding: 8px;
  }
  .chip {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.5rem 0.8rem;
    min-height: 44px;
    border-radius: 999px;
    border: 1.5px solid var(--oyster);
    background: var(--paper-2);
    color: var(--ink);
    cursor: pointer;
  }
  .picked-chip {
    border-color: var(--sunrise);
    background: color-mix(in srgb, var(--sunrise) 18%, var(--paper-2));
  }
  .textform {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .textform input {
    flex: 1 1 200px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1.5px solid var(--oyster);
    border-radius: var(--radius);
    background: var(--paper-2);
    color: var(--ink);
    font: inherit;
  }
  .result {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--paper-2);
    border-left: 4px solid var(--sunrise);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .result-word {
    font-size: 1.6rem;
    color: var(--sunrise-ink);
    margin: 0 0 0.25rem;
  }
  .badge-earned {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.5rem 0 1rem;
  }
  .badge-earned img {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  .badge-earned p {
    margin: 0;
    font-size: 1.5rem;
    color: var(--sunrise-ink);
  }
</style>
