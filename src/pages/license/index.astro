---
// The Assistant Guide license: a printable certificate. The name comes from the device (Mission 23)
// or is typed in here; it is never sent anywhere.
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import { artImage, sketchImage } from '@lib/images';
import { url } from '@lib/url';
import site from '../../../site.config.mjs';

const badges = ['snook', 'tarpon', 'captain'].map((id) => ({ id, img: artImage('emblems', `badge-${id}`) }));
const mark = artImage('emblems', 'site-mark');
const map = sketchImage('lostmans-river-hand-map.png');
// GPT's painted blank (tiles/license-blank): frame, name line and three badge circles, no text.
// When it exists the certificate is laid over it by percentages; otherwise the plain layout prints.
const blank = artImage('tiles', 'license-blank');
---

<Base title="Assistant Guide license" description="Print your Assistant Guide license." noindex>
  <div class="wrap section no-print">
    <p class="small"><a href={url('/missions/')}>← Your summer</a></p>
    <h1>Your license</h1>
    <p class="lede">Finish the missions, sign the Guidebook, and print this. The name only lives on this phone.</p>
    <form class="namer" id="namer">
      <label for="lic-name">Name on the license</label>
      <input id="lic-name" type="text" maxlength="40" placeholder="First name" />
      <button class="btn btn-primary" type="submit">Update</button>
      <button class="btn" type="button" id="print">Print</button>
    </form>
  </div>

  <section class="license" id="license" aria-label="Assistant Guide license">
    <div class:list={['lic-inner', { painted: !!blank }]}>
      {blank && <Image class="lic-bg" src={blank} alt="" width={1600} sizes="(min-width: 900px) 820px, 96vw" loading="eager" />}
      <div class="lic-top">
        {mark && <Image class="lic-mark" src={mark} alt="" width={160} height={160} />}
        <p class="lic-eyebrow hand">Chokoloskee Island · Ten Thousand Islands</p>
        <h2 class="lic-title">Assistant Fishing Guide</h2>
        <p class="lic-sub">This certifies that</p>
        <p class="lic-name" id="lic-name-out">____________________</p>
        <p class="lic-sub lic-count">
          spent a summer at Lostman’s River, completed <strong id="lic-count">0</strong> of 23 missions and <strong id="lic-field">0</strong> field missions signed off by a captain, learned the
          water, and signed the Guidebook.
        </p>
      </div>
      <ul class="lic-badges">
        {
          badges.map((b) => (
            <li class="lic-badge" data-badge={b.id}>
              {b.img && <Image src={b.img} alt={`${b.id} badge`} width={200} height={200} />}
            </li>
          ))
        }
      </ul>
      <div class="lic-bottom">
        <p class="lic-line">
          <span class="hand">Capt. Daniel W. Panther Jr.</span>
          <span class="mono">Charter captain</span>
        </p>
        <p class="lic-line">
          <span id="lic-date" class="mono">&nbsp;</span>
          <span class="mono">Date</span>
        </p>
      </div>
      {map && !blank && <Image class="lic-map art" src={map} alt="" width={400} loading="lazy" />}
      <p class="lic-foot mono">lostmansriver.com · from the novel Escape to Lostman’s River by {site.authors}</p>
    </div>
  </section>

  <script>
    import { load, setName, countDone, countField } from '../../scripts/progress';
    import { track } from '../../scripts/track';
    const p = load();
    const out = document.getElementById('lic-name-out')!;
    const input = document.getElementById('lic-name') as HTMLInputElement;
    const render = () => {
      const q = load();
      out.textContent = q.name || '____________________';
      document.getElementById('lic-count')!.textContent = String(countDone(q));
      document.getElementById('lic-field')!.textContent = String(countField(q));
      for (const b of q.badges) document.querySelector(`[data-badge="${b}"]`)?.classList.add('earned');
      document.getElementById('lic-date')!.textContent = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
    };
    input.value = p.name;
    render();
    (document.getElementById('namer') as HTMLFormElement).addEventListener('submit', (e) => {
      e.preventDefault();
      setName(input.value);
      render();
    });
    document.getElementById('print')!.addEventListener('click', () => {
      track('license_print', { missions: countDone(load()) });
      window.print();
    });
  </script>
</Base>

<style>
  .namer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .namer input {
    flex: 1 1 180px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1.5px solid var(--oyster);
    border-radius: var(--radius);
    background: var(--paper-2);
    color: var(--ink);
    font: inherit;
  }
  .license {
    max-width: 820px;
    margin: 0 auto 3rem;
    padding: 0 var(--gutter);
    container-type: inline-size;
  }
  /* painted blank: 3:2 canvas, everything placed by percentage, type scaled to the card width */
  .lic-inner.painted {
    aspect-ratio: 3 / 2;
    padding: 0;
    border: 0;
    outline: 0;
    background: #fff;
  }
  .painted .lic-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }
  .painted .lic-top {
    position: absolute;
    inset: 0;
    padding: 4.5% 16% 0;
    margin: 0;
  }
  .painted .lic-mark {
    width: 6cqw;
    height: 6cqw;
    margin-bottom: 0;
  }
  .painted .lic-eyebrow {
    font-size: 2.6cqw;
    line-height: 1.1;
  }
  .painted .lic-title {
    font-size: 4.6cqw;
    margin: 0.3cqw 0 0.4cqw;
    line-height: 1.05;
  }
  .painted .lic-sub {
    font-size: 1.9cqw;
    margin: 0;
  }
  .painted .lic-name {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 35.5%;
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 4.2cqw;
    line-height: 1;
  }
  .painted .lic-count {
    position: absolute;
    left: 17%;
    right: 17%;
    top: 80%;
    font-size: 1.5cqw;
    line-height: 1.3;
    max-width: none;
  }
  .painted .lic-badges {
    position: absolute;
    inset: 0;
    margin: 0;
    display: block;
  }
  .painted .lic-badge {
    position: absolute;
    top: 49.5%;
    width: 19%;
    height: 28.5%;
    display: grid;
    place-items: center;
  }
  .painted .lic-badge:nth-child(1) {
    left: 13.6%;
  }
  .painted .lic-badge:nth-child(2) {
    left: 40.5%;
  }
  .painted .lic-badge:nth-child(3) {
    left: 67.4%;
  }
  .painted .lic-badge img {
    width: 100%;
    height: 100%;
  }
  .painted .lic-bottom {
    position: absolute;
    left: 26%;
    right: 26%;
    top: 88.5%;
    margin: 0;
    gap: 6%;
  }
  .painted .lic-line {
    min-width: 0;
    flex: 1;
    padding-top: 0.4cqw;
  }
  .painted .lic-line .hand {
    font-size: 2.2cqw;
    line-height: 1;
  }
  .painted .lic-line .mono {
    font-size: 1.1cqw;
  }
  .painted #lic-date {
    font-size: 1.4cqw;
  }
  .painted .lic-foot {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 1.4%;
    margin: 0;
    font-size: 1cqw;
  }
  .lic-inner {
    position: relative;
    background: #fbf7ee;
    color: #1f2a2e;
    border: 3px double #b8b2a6;
    outline: 1px solid #b8b2a6;
    outline-offset: 6px;
    padding: 2.5rem 2rem 2rem;
    text-align: center;
    overflow: hidden;
  }
  .lic-mark {
    width: 72px;
    height: 72px;
    margin: 0 auto 0.5rem;
  }
  .lic-eyebrow {
    color: #a04d12;
    font-size: 1.3rem;
    margin: 0;
  }
  .lic-title {
    font-size: 2.2rem;
    color: #2f5d50;
    margin: 0.2rem 0 0.5rem;
    letter-spacing: 0.02em;
  }
  .lic-sub {
    margin: 0.25rem auto;
    max-width: 48ch;
    color: #4b5a60;
  }
  .lic-name {
    font-family: var(--font-hand);
    font-size: 2.4rem;
    color: #1f2a2e;
    margin: 0.5rem 0;
    border-bottom: 1px solid #b8b2a6;
    display: inline-block;
    min-width: 50%;
    padding: 0 1rem 0.2rem;
  }
  .lic-badges {
    list-style: none;
    padding: 0;
    margin: 1.25rem auto;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }
  .lic-badge img {
    width: 96px;
    height: 96px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.25;
  }
  .lic-badge.earned img {
    filter: none;
    opacity: 1;
  }
  .lic-bottom {
    display: flex;
    justify-content: space-around;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .lic-line {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    border-top: 1px solid #1f2a2e;
    min-width: 200px;
    padding-top: 0.3rem;
    margin: 0;
  }
  .lic-line .hand {
    font-size: 1.4rem;
  }
  .lic-line .mono {
    font-size: 0.7rem;
    color: #4b5a60;
  }
  .lic-map {
    position: absolute;
    right: -40px;
    bottom: -30px;
    width: 220px;
    opacity: 0.12;
    pointer-events: none;
  }
  .lic-foot {
    margin: 1.5rem 0 0;
    font-size: 0.65rem;
    color: #4b5a60;
  }
  @media print {
    :global(header.site-header),
    :global(footer.site-footer),
    .no-print {
      display: none !important;
    }
    .license {
      margin: 0;
      padding: 0;
      max-width: none;
    }
    .lic-inner {
      border-color: #999;
    }
    :global(body) {
      background: #fff;
    }
    .lic-inner.painted {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    @page {
      size: letter landscape;
      margin: 0.6in;
    }
  }
</style>
