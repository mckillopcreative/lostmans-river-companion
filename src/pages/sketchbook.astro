---
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Lightbox from '@components/Lightbox.astro';
import ChapterPill from '@components/ChapterPill.astro';
import { sketches, chapterByN } from '@lib/data';
import { sketchImage } from '@lib/images';
import { url } from '@lib/url';
import site from '../../site.config.mjs';

const ordered = [...sketches].sort((a, b) => a.chapters[0]! - b.chapters[0]!);
---

<Base title="Sketchbook" description="Every pen-and-ink sketch from the book, drawn by Linda McKillop, large enough to see the lines.">
  <div class="wrap-wide section">
    <header class="sb-head">
      <p class="eyebrow">The margins</p>
      <h1>Sketchbook</h1>
      <p class="lede">
        Eleven drawings by {site.artist}, the ones Matt would have made in the back of the Guidebook if he could draw this well. Tap any sketch to see it full size.
      </p>
    </header>

    <ul class="sb-grid">
      {
        ordered.map((s) => {
          const img = sketchImage(s.file)!;
          const ch = s.chapters[0]!;
          return (
            <li class="sb-item">
              <figure class="sketch">
                <Image
                  src={img}
                  alt={s.subject}
                  width={800}
                  sizes="(min-width: 900px) 520px, 94vw"
                  loading="lazy"
                  data-lightbox={img.src}
                  data-lightbox-alt={`${s.subject} — Illustration © ${s.artist}`}
                />
                <figcaption>
                  <span class="sb-subject">{s.subject}</span>
                  <span class="sb-meta small muted">
                    <ChapterPill n={ch} /> <a href={url(`/ch/${ch}/`)}>{chapterByN.get(ch)?.title}</a>
                    {s.also_used && <span> · also the {s.also_used}</span>}
                  </span>
                  <span class="sb-credit mono">Illustration © {s.artist}</span>
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>

    <p class="note small">
      These are scans of the originals, trimmed to the drawing. If you own the book, the printed versions sit at the head of each chapter. Higher-resolution scans are on the author’s list.
    </p>
  </div>
  <Lightbox />
</Base>

<style>
  .sb-head {
    max-width: var(--measure);
  }
  .sb-grid {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .sb-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sb-item figure {
    margin: 0;
    background: var(--paper-2);
    border-radius: var(--radius);
    padding: 1rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .sb-item img {
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }
  .sb-subject {
    display: block;
    font-weight: 600;
    color: var(--mangrove);
  }
  .sb-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }
  .sb-credit {
    display: block;
    font-size: 0.7rem;
    color: var(--ink-soft);
  }
</style>
