---
// The Lostman's River Experience — the app home a buyer lands on. Visual-first: a grid of
// tiles, one to three words each. Tile art comes from assets/art/tiles/<id>.(png|webp)
// (docs/APP-HOME-BRIEF.md); the section emblems stand in for any tile without art.
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import AuthorsCard from '@components/AuthorsCard.astro';
import ChapterAudio from '@components/ChapterAudio.astro';
import BuyButton from '@components/BuyButton.astro';
import ExperienceBanner from '@components/ExperienceBanner.astro';
import HandOff from '@components/HandOff.astro';
import { artImage } from '@lib/images';
import { url } from '@lib/url';
import { chapters, fish, places, todo } from '@lib/data';
import site from '../../../site.config.mjs';

type Tile = { id: string; label: string; sub?: string; href: string; emblem?: string; size?: 'wide' | 'tall' | 'big'; soon?: boolean; art?: [string, string] };
const tiles: Tile[] = [
  { id: 'read', label: 'Read the book', sub: `${chapters.length} chapters`, href: '/ch/1/', emblem: 'about', size: 'big', art: ['emblems', 'journal-card'] },
  { id: 'listen', label: 'Listen to the book', sub: 'Chapter 1 ready', href: '/ch/1/#listen-ch-01', emblem: 'sketchbook', size: 'wide' },
  { id: 'missions', label: 'Your summer', sub: '23 missions · 23 field missions · 3 badges', href: '/missions/', emblem: 'list', size: 'tall' },
  { id: 'chart', label: 'The Chart', href: '/map/', emblem: 'chart' },
  { id: 'fish', label: 'Fish', sub: `${fish.length} species`, href: '/fish/', emblem: 'fish' },
  { id: 'crew', label: 'Crew', href: '/crew/', emblem: 'crew' },
  { id: 'critters', label: 'Critters', href: '/critters/', emblem: 'critters' },
  { id: 'boats', label: 'Boats', sub: 'in the book', href: '/boats/', emblem: 'boats' },
  { id: 'boat-types', label: 'Types of boats', sub: 'skiffs · airboats · kayaks', href: '/boats/types/', emblem: 'boats' },
  { id: 'tackle', label: 'Tackle Box', href: '/tackle/', emblem: 'tackle' },
  { id: 'knots', label: 'Knots', sub: 'five to master', href: '/knots/', emblem: 'tackle' },
  { id: 'fish-id', label: 'Fish ID game', sub: 'ten rounds', href: '/games/fish-id/', emblem: 'fish' },
  { id: 'chart-puzzles', label: 'Name that key', sub: 'chart puzzle', href: '/games/chart/', emblem: 'chart' },
  { id: 'tides', label: 'Tides', sub: 'today at Chokoloskee', href: '/tides/', emblem: 'chart' },
  { id: 'places', label: 'Places', sub: `${places.length} painted`, href: '/places/', emblem: 'chart', size: 'wide' },
  { id: 'list', label: 'Matt’s List', sub: `${todo.length} items`, href: '/list/', emblem: 'list' },
  { id: 'sketchbook', label: 'Sketchbook', href: '/sketchbook/', emblem: 'sketchbook' },
  { id: 'printables', label: 'Your license', sub: 'print it', href: '/license/', emblem: 'list' },
  { id: 'journal', label: 'Field Journal', sub: 'print it · fill it in by hand', href: '/field-journal/', emblem: 'sketchbook' },
];
// a tile's art: its own file in tiles/, or a named plate (shown whole, not cropped), else the section emblem
const hero = artImage('tiles', 'app-hero');
const art = (t: Tile) => artImage('tiles', t.id) ?? (t.art ? artImage(t.art[0], t.art[1]) : null) ?? (t.emblem ? artImage('emblems', `emblem-${t.emblem}`) : null);
---

<Base title="Lostman’s River: Fishing Guide Experience" description="Your summer as an assistant fishing guide: read, listen, learn the water, earn the license.">
  <HandOff />

  <section class="app-hero">
    <div class="wrap-wide">
      <ExperienceBanner as="h1" class="app-hero-banner" />
    </div>
    <div class="wrap-wide app-hero-grid">
      <div>
        {!hero && <p class="eyebrow">Welcome aboard</p>}
        {!hero && <h1>Summer Fishing Guide Experience</h1>}
        {!hero && <p class="app-banner-line">You’re the assistant fishing guide this summer. Lots to learn.</p>}
        <p class="lede">Same job Matt had. Read the book, listen along, learn the water, and earn your Lostman’s River Fishing Guide license.</p>
        <div class="progress" role="group" aria-label="Your progress">
          <span class="pill is-current" id="p-missions">0 of 23 missions</span>
          <span class="pill" id="p-badges">0 badges</span>
          <a class="pill" id="p-next" href={url('/missions/m01/')}>Start: Mission 1</a>
        </div>
        <BuyButton compact />
      </div>
      <ChapterAudio n={1} title="Start listening: Chapter 1" compact />
    </div>
  </section>

  <section class="wrap-wide tiles-wrap" aria-label="The experience">
    <ul class="tiles" data-reveal-stagger>
      {
        tiles.map((t) => {
          const img = art(t);
          const own = !!artImage('tiles', t.id) || !!(t.art && artImage(t.art[0], t.art[1]));
          const plate = !artImage('tiles', t.id) && !!(t.art && artImage(t.art[0], t.art[1]));
          return (
            <li class:list={['tile', t.size, { soon: t.soon }]}>
              <a href={url(t.href)} data-track="tile_click" data-track-tile={t.id} aria-label={`${t.label}${t.sub ? ', ' + t.sub : ''}${t.soon ? ' (coming soon)' : ''}`}>
                <span class:list={['tile-art', 'art', { placeholder: !own, plate }]}>
                  {img && <Image src={img} alt="" width={own ? 800 : 400} sizes={t.size === 'big' ? '(min-width: 900px) 520px, 94vw' : '(min-width: 900px) 260px, 45vw'} loading="lazy" />}
                </span>
                <span class="tile-text">
                  <span class="tile-label">{t.label}</span>
                  {t.sub && <span class="tile-sub mono">{t.sub}</span>}
                </span>
                {t.soon && <span class="tile-soon hand">soon</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <script>
    import { load, countDone } from '../../scripts/progress';
    import { track } from '../../scripts/track';
    if (new URLSearchParams(location.search).get('welcome') === '1') track('checkout_return');
    const p = load();
    const done = countDone(p);
    document.getElementById('p-missions')!.textContent = `${done} of 23 missions`;
    document.getElementById('p-badges')!.textContent = `${p.badges.length} badge${p.badges.length === 1 ? '' : 's'}`;
    const next = document.getElementById('p-next') as HTMLAnchorElement;
    // first unfinished mission (they may be done out of order)
    const firstOpen = Array.from({ length: 23 }, (_, i) => i + 1).find((i) => !p.missions['m' + String(i).padStart(2, '0')]);
    const n = firstOpen ?? 23;
    next.textContent = done >= 23 ? 'Print your license' : `${done ? 'Next' : 'Start'}: Mission ${n}`;
    // the server renders the link to Mission 1; swap it for the next mission or the license
    next.href = done >= 23 ? next.href.replace('missions/m01/', 'license/') : next.href.replace('m01', 'm' + String(n).padStart(2, '0'));
  </script>

  <section class="wrap section">
    <AuthorsCard />
    <p class="small muted center">
      <a href={url('/about/')}>About the book</a> · <a href={site.buyUrl} rel="noopener">The paperback on Amazon</a>
    </p>
  </section>
</Base>

<style>
  .app-hero {
    padding-block: 2rem 1.5rem;
  }
  .app-hero :global(.app-hero-banner) {
    margin-bottom: 1.25rem;
  }
  /* fallback when the painting is missing: the welcome line styled like the banner's */
  .app-hero-grid .app-banner-line {
    margin: 0 0 0.4rem;
    font-weight: 700;
    font-size: clamp(1.45rem, 4vw, 2.6rem);
    line-height: 1.1;
    color: var(--mangrove);
  }
  .app-hero:has(.app-hero-banner) .app-hero-grid {
    align-items: center;
  }
  .app-hero-grid {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .app-hero-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
  }
  .app-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin-bottom: 0.4rem;
  }
  .progress {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .tiles-wrap {
    padding-block: 0.5rem 2rem;
  }
  .tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 150px;
    grid-auto-flow: dense;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .tiles {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 170px;
      gap: 14px;
    }
  }
  @media (min-width: 1000px) {
    .tiles {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 180px;
      gap: 16px;
    }
  }
  .tile.wide {
    grid-column: span 2;
  }
  .tile.tall {
    grid-row: span 2;
  }
  .tile.big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid color-mix(in srgb, var(--oyster) 60%, transparent);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s, border-color 0.15s;
  }
  .tile a:hover {
    transform: translateY(-3px);
    border-color: var(--gulf);
  }
  .tile-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 10%;
  }
  .tile-art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .tile-art.placeholder img {
    width: 62%;
    height: 62%;
    transform: translateY(-10%);
  }
  /* real tile art is painted edge to edge (brief §5): fill the card, keep the quiet bottom for the label */
  .tile-art:not(.placeholder) {
    padding: 0;
  }
  .tile-art:not(.placeholder) img {
    object-fit: cover;
    object-position: center 35%;
  }
  /* a plate (transparent subject) is shown whole on the paper, like the journal on the Read tile */
  .tile-art.plate {
    padding: 0 3% 13%;
    transform: translateY(-10px);
  }
  .tile-art.plate img {
    object-fit: contain;
    object-position: center;
  }
  .tile-art:not(.placeholder) + .tile-text {
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--paper-2) 88%, transparent) 45%);
    padding-top: 1.4rem;
  }
  .tile-text {
    position: relative;
    padding: 0.6rem 0.75rem 0.7rem;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--paper-2) 92%, transparent) 40%);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .tile-label {
    font-weight: 700;
    color: var(--mangrove);
    font-size: 1rem;
    line-height: 1.15;
  }
  .tile.big .tile-label {
    font-size: 1.4rem;
  }
  .tile-sub {
    font-size: 0.68rem;
    color: var(--ink-soft);
  }
  .tile-soon {
    position: absolute;
    top: 8px;
    right: 10px;
    color: var(--sunrise-ink);
    font-size: 1.1rem;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
    padding: 0 0.45rem;
    border-radius: 999px;
  }
  .tile.soon a {
    opacity: 0.85;
  }
  .center {
    text-align: center;
    margin-top: 1rem;
  }
</style>
