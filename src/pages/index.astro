---
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import SignupForm from '@components/SignupForm.astro';
import Divider from '@components/Divider.astro';
import CompassRose from '@components/CompassRose.astro';
import { sketchImage, coverImage } from '@lib/images';
import { url } from '@lib/url';
import site from '../../site.config.mjs';

const tarpon = sketchImage('tarpon-leap-houseboat.png')!;
const cover = coverImage();
const entries = [
  { href: '/map/', title: 'The Chart', text: 'Every place in the book on a real chart, with Matt’s routes chapter by chapter.', sketch: 'lostmans-river-hand-map.png' },
  { href: '/fish/', title: 'Fish', text: 'Twenty-three species, what they look like, and how Matt went after them.', sketch: 'matt-holding-snook.png' },
  { href: '/crew/', title: 'Crew', text: 'Dan, Snapper, Rose, Doc, two pelicans and one very old tarpon.', sketch: 'pelican-on-dock.png' },
];
---

<Base title={site.title} description={site.tagline} image="/assets/sketches/tarpon-leap-houseboat.png">
  <section class="hero">
    <div class="wrap-wide hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">An Everglades adventure novel</p>
        <h1 class="hero-title">Escape to Lostman’s River</h1>
        <p class="hero-lede">
          One summer, one houseboat, one legendary tarpon. Fifteen-year-old Matt Creek goes to work for his uncle Dan, a fishing guide in the Ten Thousand Islands, and ends up with more than fish on the line.
        </p>
        <div class="hero-cta">
          {
            cover && (
              <a class="book-chip" href={site.buyUrl} rel="noopener" aria-label="The paperback — buy on Amazon">
                <Image src={cover} alt="Cover of Escape to Lostman’s River" width={120} loading="eager" />
              </a>
            )
          }
          <p class="cluster">
            <a class="btn btn-primary" href={site.buyUrl} rel="noopener">Amazon</a>
            <a class="btn" href={url('/map/')}>Open the chart</a>
          </p>
        </div>
        <p class="small laurel">
          <a href={site.joelbooks.url} rel="noopener">{site.joelbooks.text}</a>
        </p>
      </div>
      <figure class="sketch hero-art">
        <Image src={tarpon} alt="A tarpon leaping beside the Sea Belle houseboat, line tight" width={1000} sizes="(min-width: 900px) 560px, 100vw" loading="eager" fetchpriority="high" />
        <figcaption class="mono">Old Scarface, Ch. 19 — Illustration © {site.artist}</figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap-wide section guide">
    <div class="guide-head">
      <CompassRose size={84} class="guide-compass" />
      <div>
        <p class="eyebrow">This is the Guidebook</p>
        <h2 class="h2-tight">Matt’s dad left him a fishing guidebook with blank pages. This is what he filled them with.</h2>
      </div>
    </div>
    <ul class="entries">
      {
        entries.map((e) => {
          const img = sketchImage(e.sketch)!;
          return (
            <li>
              <a class="entry" href={url(e.href)}>
                <div class="sketch entry-art">
                  <Image src={img} alt="" width={600} sizes="(min-width: 720px) 340px, 94vw" loading="lazy" />
                </div>
                <span class="entry-title">{e.title}</span>
                <span class="entry-text">{e.text}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="also cluster small">
      Also in the book:
      <a class="pill" href={url('/critters/')}>Critters</a>
      <a class="pill" href={url('/boats/')}>Boats</a>
      <a class="pill" href={url('/tackle/')}>Tackle Box</a>
      <a class="pill" href={url('/list/')}>Matt’s List</a>
      <a class="pill" href={url('/sketchbook/')}>Sketchbook</a>
    </p>
  </section>

  <Divider kind="mullet" />

  <section class="wrap section scan">
    <div class="scan-box">
      <p class="eyebrow">Reading the book?</p>
      <h2 class="h2-tight">Scan the code at the top of any chapter.</h2>
      <p>It opens that chapter’s page here: where Matt is on the chart, which fish are in play, who is in the boat, and what Dan is talking about. No spoilers past the chapter you are on.</p>
      <p><a class="btn btn-sm" href={url('/ch/1/')}>Start at Chapter 1 →</a></p>
    </div>
  </section>

  {
    site.pullQuotes.length > 0 && (
      <>
        <Divider kind="wave" />
        <section class="wrap section">
          <p class="eyebrow">Readers</p>
          <div class="quotes">
            {site.pullQuotes.map((q) => (
              <blockquote>
                “{q.text}”<cite>— {q.who}</cite>
              </blockquote>
            ))}
          </div>
        </section>
      </>
    )
  }

  <section class="wrap">
    <SignupForm id="signup-home" compact />
  </section>
</Base>

<style>
  /* ---- Hero: plain paper; copy left, Linda's tarpon whole and unobstructed right ---- */
  .hero {
    border-bottom: 1px solid color-mix(in srgb, var(--oyster) 60%, transparent);
    padding-block: 2rem 2.5rem;
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero {
      padding-block: 3.5rem 4rem;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 3.5rem;
    }
  }
  .hero-title {
    font-size: clamp(2.4rem, 5.6vw, 3.9rem);
    line-height: 1.04;
    margin-bottom: 0.5rem;
  }
  .hero-lede {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 42ch;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }
  .book-chip {
    flex: none;
    width: 58px;
    display: block;
    transform: rotate(-3deg);
    filter: drop-shadow(0 6px 8px rgb(0 0 0 / 0.3));
    transition: transform 0.15s;
  }
  .book-chip:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  .book-chip img {
    width: 100%;
    height: auto;
    border-radius: 2px 4px 4px 2px;
  }
  .laurel {
    margin-top: 0.75rem;
  }
  .hero-art {
    margin: 0;
    padding: 1rem 1rem 0.5rem;
    background: var(--paper-2);
    border-radius: var(--radius);
  }
  .hero-art img {
    width: 100%;
    height: auto;
  }
  .hero-art figcaption {
    font-size: 0.7rem;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }

  /* ---- Guidebook entries ---- */
  .guide-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: center;
    max-width: 48rem;
  }
  .guide-compass {
    flex: none;
  }
  .h2-tight {
    margin-top: 0;
    max-width: 26ch;
  }
  .entries {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 720px) {
    .entries {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
    background: var(--paper-2);
    border: 1px solid color-mix(in srgb, var(--oyster) 60%, transparent);
    border-radius: var(--radius);
    padding: 1rem;
    height: 100%;
    box-shadow: var(--shadow);
    transition: transform 0.15s, border-color 0.15s;
  }
  .entry:hover {
    transform: translateY(-2px);
    border-color: var(--gulf);
    color: inherit;
  }
  .entry-art {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .entry-art img {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }
  .entry-title {
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--mangrove);
  }
  .entry-text {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .also {
    margin-top: 1.5rem;
  }
  .scan-box {
    background: var(--paper-2);
    border-left: 4px solid var(--sunrise);
    padding: 1.25rem 1.5rem;
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .quotes {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .quotes {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
